        "language": "js",
        "code": "import { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { calculateImpact, savingPerKm, getAlternative, roundKg, CALC_LIMITS } from '../../features/impact/impact.js';\n\ndescribe('getAlternative', () => {\n  test('unknown id falls back to first alternative (walk)', () => {\n    assert.equal(getAlternative('spaceship').id, 'walk');\n  });\n});\n\ndescribe('savingPerKm', () => {\n  test('carpool uses shareOfCar formula (point estimate, not a range)', () => {\n    const [low, high] = savingPerKm('carpool', 200);\n    assert.equal(low, high);\n    assert.equal(low, 100);\n  });\n  test('bus returns a [low,high] range from 0 to car-bus delta', () => {\n    const [low, high] = savingPerKm('bus', 249);\n    assert.equal(low, 249 - 104);\n    assert.equal(high, 249);\n  });\n  test('never returns negative values even if altHigh > carFactor', () => {\n    const [low] = savingPerKm('bus', 50); // carFactor < bus factor\n    assert.ok(low >= 0);\n  });\n});\n\ndescribe('calculateImpact clamping', () => {\n  test('out-of-range tripsPerWeek is clamped to limits', () => {\n    const r = calculateImpact({ tripsPerWeek: 999, alternative: 'walk' });\n    assert.equal(r.inputs.tripsPerWeek, CALC_LIMITS.trips.max);\n  });\n  test('non-finite carFactor falls back to min', () => {\n    const r = calculateImpact({ carFactor: NaN, alternative: 'walk' });\n    assert.equal(r.inputs.carFactor, CALC_LIMITS.carFactor.min);\n  });\n  test('unknown alternative id does not throw, defaults to walk', () => {\n    assert.doesNotThrow(() => calculateImpact({ alternative: 'teleport' }));\n  });\n});\n\ndescribe('calculateImpact series generation', () => {\n  test('weeks <= 12 -> one column per week', () => {\n    const r = calculateImpact({ weeks: 5, alternative: 'walk' });\n    assert.deepEqual(r.series.map((s) => s.week), [1,2,3,4,5]);\n  });\n  test('weeks > 12 -> 12 evenly spaced checkpoints', () => {\n    const r = calculateImpact({ weeks: 52, alternative: 'walk' });\n    assert.equal(r.series.length, 12);\n    assert.equal(r.series[11].week, 52);\n  });\n});\n\ndescribe('calculateImpact isRange / activeHours', () => {\n  test('walk/bike: isRange false (0 spread)', () => {\n    assert.equal(calculateImpact({ alternative: 'walk' }).isRange, false);\n  });\n  test('bus: isRange true', () => {\n    assert.equal(calculateImpact({ alternative: 'bus' }).isRange, true);\n  });\n  test('carpool: activeHours is null (no speedKmh)', () => {\n    assert.equal(calculateImpact({ alternative: 'carpool' }).activeHours, null);\n  });\n});\n\ndescribe('roundKg', () => {\n  test('zero/negative -> 0', () => { assert.equal(roundKg(0), 0); assert.equal(roundKg(-5), 0); });\n  test('< 1 -> one decimal', () => assert.equal(roundKg(0.456), 0.5));\n  test('exact power of 10 boundary', () => assert.equal(roundKg(100), 100));\n  test('NaN/Infinity -> 0', () => { assert.equal(roundKg(NaN), 0); assert.equal(roundKg(Infinity), 0); });\n});"
