        "language": "js",
        "code": "import { test, describe, beforeEach } from 'node:test';\nimport assert from 'node:assert/strict';\n\nfunction installFakeWindow() {\n  const store = new Map();\n  const listeners = new Map(); // type -> Set<fn>\n  global.window = {\n    localStorage: {\n      getItem: (k) => (store.has(k) ? store.get(k) : null),\n      setItem: (k, v) => store.set(k, v),\n    },\n    addEventListener: (type, fn) => { (listeners.get(type) ?? listeners.set(type, new Set()).get(type)).add(fn); },\n    removeEventListener: (type, fn) => listeners.get(type)?.delete(fn),\n  };\n  return { store, fire: (type, evt) => listeners.get(type)?.forEach((fn) => fn(evt)) };\n}\n\ndescribe('progress store integration', () => {\n  let fakeWin;\n  beforeEach(async (t) => {\n    fakeWin = installFakeWindow();\n    t.after(() => { delete global.window; });\n    // store.js caches module-level state; re-import with cache-busting query per test\n  });\n\n  test('getServerSnapshot always returns INITIAL_STATE regardless of localStorage contents', async () => {\n    fakeWin.store.set('havo:v1', JSON.stringify({ plan: [{ id: '1', refId: 'r' }] }));\n    const { useHavoState } = await import(`../../features/progress/store.js?t=${Date.now()}`);\n    // exercised via renderHook in a React-aware test environment; assert the\n    // server snapshot function itself is pure INITIAL_STATE if exported/testable.\n  });\n\n  test('a storage event for a different key is ignored', async () => {\n    const mod = await import(`../../features/progress/store.js?t=${Date.now()}1`);\n    fakeWin.fire('storage', { key: 'some-other-app:v1' });\n    // assert internal state unchanged (requires exposing a snapshot getter, or\n    // testing indirectly through havoActions + a subscribed listener spy).\n  });\n\n  test('dispatch does not call localStorage.setItem when reducer is a no-op', async () => {\n    const { havoActions } = await import(`../../features/progress/store.js?t=${Date.now()}2`);\n    let calls = 0;\n    const realSetItem = fakeWin.store.set.bind(fakeWin.store);\n    global.window.localStorage.setItem = (...args) => { calls++; return realSetItem(...args); };\n    havoActions.addToPlan({ kind: 'action', refId: 'dup' });\n    const before = calls;\n    havoActions.addToPlan({ kind: 'action', refId: 'dup' }); // duplicate, should no-op\n    assert.equal(calls, before);\n  });\n});"
