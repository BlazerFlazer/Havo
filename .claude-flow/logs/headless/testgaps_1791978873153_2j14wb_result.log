        "code": "import { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { buildLayout, createSim, step, settle, levelBand, explain, WIND_SPEEDS } from '../../features/problem/inversionSim.js';\n\ndescribe('buildLayout', () => {\n  test('is deterministic for the same dimensions (fixed seed)', () => {\n    const a = buildLayout(800, 400);\n    const b = buildLayout(800, 400);\n    assert.deepEqual(a.buildings, b.buildings);\n    assert.deepEqual(a.chimneys, b.chimneys);\n  });\n});\n\ndescribe('step', () => {\n  test('respects MAX_PARTICLES cap over many frames', () => {\n    const layout = buildLayout(800, 400);\n    const sim = createSim(layout);\n    for (let i = 0; i < 3000; i++) step(sim, { inversion: true, wind: 0, rain: false, traffic: 3, heating: 3 });\n    assert.ok(sim.particles.length <= 900);\n  });\n  test('inversion keeps particles below the lid (lidY)', () => {\n    const layout = buildLayout(800, 400);\n    const sim = createSim(layout);\n    for (let i = 0; i < 500; i++) step(sim, { inversion: true, wind: 0, rain: false, traffic: 3, heating: 3 });\n    for (const p of sim.particles) assert.ok(p.y >= layout.lidY - 5);\n  });\n});\n\ndescribe('settle', () => {\n  test('sets level directly from instantaneous zoneLevel (no smoothing lag)', () => {\n    const layout = buildLayout(800, 400);\n    const sim = createSim(layout);\n    settle(sim, { inversion: true, wind: 0, rain: false, traffic: 3, heating: 3 }, 1600);\n    assert.ok(sim.level >= 0 && sim.level <= 100);\n  });\n});\n\ndescribe('levelBand', () => {\n  test('boundary at 30', () => { assert.equal(levelBand(29.9).id, 'low'); assert.equal(levelBand(30).id, 'mid'); });\n  test('boundary at 60', () => { assert.equal(levelBand(59.9).id, 'mid'); assert.equal(levelBand(60).id, 'high'); });\n});\n\ndescribe('explain', () => {\n  test('no sources', () => assert.match(explain({ traffic: 0, heating: 0, inversion: false, wind: 0, rain: false }), /Источников нет/));\n  test('inversion + calm', () => assert.match(explain({ traffic: 1, heating: 0, inversion: true, wind: 0, rain: false }), /Инверсия и безветрие/));\n  test('inversion + wind', () => assert.match(explain({ traffic: 1, heating: 0, inversion: true, wind: 1, rain: false }), /частично выносит/));\n  test('rain', () => assert.match(explain({ traffic: 1, heating: 0, inversion: false, wind: 0, rain: true }), /Осадки вымывают/));\n  test('strong wind', () => assert.match(explain({ traffic: 1, heating: 0, inversion: false, wind: 2, rain: false }), /Сильный ветер/));\n  test('default calm-clear case', () => assert.match(explain({ traffic: 1, heating: 0, inversion: false, wind: 1, rain: false }), /становится холоднее/));\n});"
