      {
        "title": "1. `lib/format.js`",
        "content": "\n**Untested functions:** `plural`, `pluralize`, `formatNumber`, `formatDate`, `formatDateTime`, `dayKey`, `timeAgo`, `daysUntil`, `deadlineLabel`.\n\n**Edge cases not covered:**\n- `plural`: n=0, n=11 (should be forms[2], not forms[1] — the `abs > 10 && abs < 20` teen exception), n=21 (forms[0]), negative n.\n- `formatNumber`: `NaN`, `Infinity`, `-Infinity` → `'—'`.\n- `formatDate`/`formatDateTime`: invalid date string → `'—'`.\n- `dayKey`: must use **local** time, not UTC (a date near midnight could differ by a day if implemented with UTC methods — worth locking down with a fixed timezone-sensitive date).\n- `timeAgo`: boundary at exactly 1 minute, 60 minutes, 24 hours; invalid input.\n- `daysUntil`: `null`/empty deadline, malformed string (not `YYYY-MM-DD`), exact today, past date.\n- `deadlineLabel`: tone mapping for danger/warn/neutral at the 0/1/negative boundaries.\n\n**Test skeleton:**\n```js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { plural, pluralize, formatNumber, formatDate, formatDateTime, dayKey, timeAgo, daysUntil, deadlineLabel } from '../../lib/format.js';\n\ndescribe('plural', () => {\n  test('n=1 -> singular form', () => assert.equal(plural(1, ['a','b','c']), 'a'));\n  test('n=2..4 -> form[1]', () => assert.equal(plural(2, ['a','b','c']), 'b'));\n  test('n=5..20 -> form[2] (teen exception)', () => assert.equal(plural(11, ['a','b','c']), 'c'));\n  test('n=21 -> form[0] again', () => assert.equal(plural(21, ['a','b','c']), 'a'));\n  test('n=0 -> form[2]', () => assert.equal(plural(0, ['a','b','c']), 'c'));\n  test('negative n uses abs value', () => assert.equal(plural(-1, ['a','b','c']), 'a'));\n});\n\ndescribe('formatNumber', () => {\n  test('NaN/Infinity -> em dash', () => {\n    assert.equal(formatNumber(NaN), '—');\n    assert.equal(formatNumber(Infinity), '—');\n  });\n  test('respects maximumFractionDigits', () => assert.equal(formatNumber(1.236, 2), '1,24'));\n});\n\ndescribe('formatDate/formatDateTime', () => {\n  test('invalid date -> em dash', () => {\n    assert.equal(formatDate('not-a-date'), '—');\n    assert.equal(formatDateTime('not-a-date'), '—');\n  });\n});\n\ndescribe('dayKey', () => {\n  test('uses local calendar day, zero-padded', () => {\n    assert.equal(dayKey(new Date(2026, 0, 5)), '2026-01-05');\n  });\n});\n\ndescribe('timeAgo', () => {\n  test('< 1 min -> \"только что\"', () => assert.equal(timeAgo(Date.now() - 1000), 'только что'));\n  test('boundary at 60 min switches to hours', () => {\n    const now = Date.now();\n    assert.match(timeAgo(now - 60 * 60000, now), /час/);\n  });\n  test('invalid input -> em dash', () => assert.equal(timeAgo('garbage'), '—'));\n});\n\ndescribe('daysUntil / deadlineLabel', () => {\n  test('null deadline -> null', () => assert.equal(daysUntil(null), null));\n  test('overdue -> negative days, danger tone', () => {\n    const now = new Date(2026, 9, 14);\n    assert.equal(daysUntil('2026-10-10', now), -4);\n    assert.equal(deadlineLabel('2026-10-10', now).tone, 'danger');\n  });\n  test('today -> tone warn, text \"сегодня\"', () => {\n    const now = new Date(2026, 9, 14);\n    assert.equal(deadlineLabel('2026-10-14', now).text, 'сегодня');\n  });\n  test('malformed deadline string -> null', () => assert.equal(daysUntil('not-a-date'), null));\n});\n```\n\n---\n\n",
