        "code": "import { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { normalizeWaqi, epaCategory, haversineKm } from '../../lib/airQuality/waqi.js';\n\nconst city = { id: 'tashkent', lat: 41.2995, lon: 69.2401 };\nconst opts = { maxStationDistanceKm: 40, staleAfterHours: 3, now: Date.parse('2026-10-14T12:00:00Z') };\n\nfunction baseJson(overrides = {}) {\n  return {\n    status: 'ok',\n    data: {\n      aqi: 85,\n      dominentpol: 'pm25',\n      city: { name: 'Tashkent', geo: [41.3, 69.24], url: 'https://aqicn.org/city/tashkent' },\n      time: { iso: '2026-10-14T11:00:00+00:00' },\n      iaqi: { pm25: { v: 85 }, pm10: { v: 40 } },\n      attributions: [{ name: 'UzHydromet', url: 'https://monitoring.meteo.uz' }],\n      ...overrides,\n    },\n  };\n}\n\ndescribe('normalizeWaqi error paths', () => {\n  test('status !== ok -> error with upstream reason string', () => {\n    const r = normalizeWaqi({ status: 'error', data: 'Invalid key' }, city, opts);\n    assert.deepEqual(r, { status: 'error', reason: 'Invalid key' });\n  });\n  test('status !== ok and data not a string -> invalid-response', () => {\n    const r = normalizeWaqi({ status: 'error', data: null }, city, opts);\n    assert.equal(r.reason, 'invalid-response');\n  });\n  test('null json -> error', () => assert.equal(normalizeWaqi(null, city, opts).status, 'error'));\n  test('missing geo -> missing-station-location', () => {\n    const json = baseJson(); delete json.data.city.geo;\n    assert.equal(normalizeWaqi(json, city, opts).reason, 'missing-station-location');\n  });\n  test('station farther than maxStationDistanceKm -> no-station, integer-rounded distance', () => {\n    const json = baseJson({ city: { name: 'Far', geo: [55, 60] } });\n    const r = normalizeWaqi(json, city, opts);\n    assert.equal(r.status, 'no-station');\n    assert.equal(Number.isInteger(r.station.distanceKm), true);\n  });\n  test('invalid time.iso -> missing-timestamp', () => {\n    const json = baseJson({ time: { iso: 'not-a-date' } });\n    assert.equal(normalizeWaqi(json, city, opts).reason, 'missing-timestamp');\n  });\n  test('no aqi and no indices -> no-data', () => {\n    const json = baseJson({ aqi: null, iaqi: {} });\n    assert.equal(normalizeWaqi(json, city, opts).status, 'no-data');\n  });\n});\n\ndescribe('normalizeWaqi happy path', () => {\n  test('partial indices omit missing pollutants (not null)', () => {\n    const json = baseJson({ iaqi: { pm25: { v: 60 } } });\n    const r = normalizeWaqi(json, city, opts);\n    assert.deepEqual(Object.keys(r.indices), ['pm25']);\n  });\n  test('dominentpol outside POLLUTANT_KEYS -> dominant null', () => {\n    const json = baseJson({ dominentpol: 'co' });\n    assert.equal(normalizeWaqi(json, city, opts).dominant, null);\n  });\n  test('stale flag true just past staleAfterHours boundary', () => {\n    const json = baseJson({ time: { iso: '2026-10-14T08:59:59+00:00' } }); // > 3h before `now`\n    assert.equal(normalizeWaqi(json, city, opts).stale, true);\n  });\n  test('rejects javascript: URLs in attributions (XSS guard)', () => {\n    const json = baseJson({ attributions: [{ name: 'evil', url: 'javascript:alert(1)' }] });\n    assert.deepEqual(normalizeWaqi(json, city, opts).attributions, []);\n  });\n  test('attributions capped at 6 entries', () => {\n    const many = Array.from({ length: 10 }, (_, i) => ({ name: `s${i}`, url: 'https://x.com' }));\n    const json = baseJson({ attributions: many });\n    assert.equal(normalizeWaqi(json, city, opts).attributions.length, 6);\n  });\n});\n\ndescribe('epaCategory', () => {\n  for (const [v, id] of [[50,'good'],[51,'moderate'],[150,'usg'],[151,'unhealthy'],[301,'hazardous']]) {\n    test(`aqi=${v} -> ${id}`, () => assert.equal(epaCategory(v).id, id));\n  }\n  test('NaN/non-number -> null', () => assert.equal(epaCategory(NaN), null));\n});\n\ndescribe('haversineKm', () => {\n  test('same point -> ~0', () => assert.ok(haversineKm(41, 69, 41, 69) < 1e-9));\n});"
