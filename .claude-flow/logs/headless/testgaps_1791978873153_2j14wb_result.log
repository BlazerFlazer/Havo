        "code": "import { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { recommendActions, MAX_RESULTS, DEFAULT_FINDER_ANSWERS } from '../../features/actions/finder.js';\n\nconst mkAction = (over) => ({\n  id: 'a', title: 'A', timeBucket: 1, cost: 'free', settings: ['school'],\n  activities: ['learning'], mode: 'solo', difficulty: 1, ...over,\n});\n\ndescribe('recommendActions hard filters', () => {\n  test('excludes actions needing more time than available', () => {\n    const r = recommendActions({ time: 1 }, [mkAction({ timeBucket: 3 })]);\n    assert.equal(r.length, 0);\n  });\n  test('excludes actions costlier than budget allows', () => {\n    const r = recommendActions({ budget: 'free' }, [mkAction({ cost: 'flexible' })]);\n    assert.equal(r.length, 0);\n  });\n  test('excludes action matching neither setting nor activity', () => {\n    const r = recommendActions(\n      { setting: 'home', activity: 'creating' },\n      [mkAction({ settings: ['school'], activities: ['learning'] })],\n    );\n    assert.equal(r.length, 0);\n  });\n});\n\ndescribe('recommendActions scoring & ranking', () => {\n  test('ties on score are broken by lower difficulty first', () => {\n    const easy = mkAction({ id: 'easy', difficulty: 1 });\n    const hard = mkAction({ id: 'hard', difficulty: 3 });\n    const r = recommendActions({ time: 3 }, [hard, easy]); // time>2 avoids the difficulty-1 nudge\n    assert.equal(r[0].action.id, 'easy');\n  });\n  test('caps results at MAX_RESULTS', () => {\n    const many = Array.from({ length: 10 }, (_, i) => mkAction({ id: `a${i}` }));\n    assert.equal(recommendActions({}, many).length, MAX_RESULTS);\n  });\n  test('missing answers fall back to DEFAULT_FINDER_ANSWERS', () => {\n    assert.doesNotThrow(() => recommendActions({}, [mkAction({})]));\n  });\n  test('empty actions list -> empty results, no throw', () => {\n    assert.deepEqual(recommendActions({}, []), []);\n  });\n});"
