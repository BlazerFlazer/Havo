// GLSL for the hero globe. Colours are authored directly in display (sRGB)
// space; the shaders intentionally skip three.js tone-mapping/colour-space
// chunks so the palette matches the CSS design tokens.

// 3D simplex noise — Ian McEwan, Ashima Arts (MIT licence).
const NOISE = /* glsl */ `
vec3 mod289(vec3 x){ return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 mod289(vec4 x){ return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 permute(vec4 x){ return mod289(((x * 34.0) + 1.0) * x); }
vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v){
  const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
  const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
  vec3 i = floor(v + dot(v, C.yyy));
  vec3 x0 = v - i + dot(i, C.xxx);
  vec3 g = step(x0.yzx, x0.xyz);
  vec3 l = 1.0 - g;
  vec3 i1 = min(g.xyz, l.zxy);
  vec3 i2 = max(g.xyz, l.zxy);
  vec3 x1 = x0 - i1 + C.xxx;
  vec3 x2 = x0 - i2 + C.yyy;
  vec3 x3 = x0 - D.yyy;
  i = mod289(i);
  vec4 p = permute(permute(permute(
            i.z + vec4(0.0, i1.z, i2.z, 1.0))
          + i.y + vec4(0.0, i1.y, i2.y, 1.0))
          + i.x + vec4(0.0, i1.x, i2.x, 1.0));
  float n_ = 0.142857142857;
  vec3 ns = n_ * D.wyz - D.xzx;
  vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
  vec4 x_ = floor(j * ns.z);
  vec4 y_ = floor(j - 7.0 * x_);
  vec4 x = x_ * ns.x + ns.yyyy;
  vec4 y = y_ * ns.x + ns.yyyy;
  vec4 h = 1.0 - abs(x) - abs(y);
  vec4 b0 = vec4(x.xy, y.xy);
  vec4 b1 = vec4(x.zw, y.zw);
  vec4 s0 = floor(b0) * 2.0 + 1.0;
  vec4 s1 = floor(b1) * 2.0 + 1.0;
  vec4 sh = -step(h, vec4(0.0));
  vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
  vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
  vec3 p0 = vec3(a0.xy, h.x);
  vec3 p1 = vec3(a0.zw, h.y);
  vec3 p2 = vec3(a1.xy, h.z);
  vec3 p3 = vec3(a1.zw, h.w);
  vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
  vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
  m = m * m;
  return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

// Fractal noise in roughly [-1, 1]. OCTAVES is injected as a define so weaker
// devices can use fewer octaves.
float fbm(vec3 p){
  float f = 0.0;
  float a = 0.5;
  for (int i = 0; i < OCTAVES; i++) {
    f += a * snoise(p);
    p = p * 2.03 + vec3(1.7, 9.2, 3.1);
    a *= 0.5;
  }
  return f;
}
`;

const SURFACE_VERTEX = /* glsl */ `
varying vec2 vUv;
varying vec3 vPosObj;
varying vec3 vNormalW;
varying vec3 vViewDirW;

void main() {
  vUv = uv;
  vPosObj = position;
  vec4 worldPos = modelMatrix * vec4(position, 1.0);
  vNormalW = normalize(mat3(modelMatrix) * normal);
  vViewDirW = normalize(cameraPosition - worldPos.xyz);
  gl_Position = projectionMatrix * viewMatrix * worldPos;
}
`;

export const earthShader = {
  vertexShader: SURFACE_VERTEX,
  fragmentShader: /* glsl */ `
uniform sampler2D uMask;   // r: land, g: Uzbekistan, b: borders
uniform float uMaskReady;
uniform float uTime;
uniform float uClean;      // 0 = hazy atmosphere, 1 = clean
uniform vec3 uSunDir;

varying vec2 vUv;
varying vec3 vPosObj;
varying vec3 vNormalW;
varying vec3 vViewDirW;

${NOISE}

void main() {
  vec3 n = normalize(vNormalW);
  vec3 v = normalize(vViewDirW);
  vec3 sun = normalize(uSunDir);

  vec4 mask = texture2D(uMask, vUv);
  // Until the geographic mask is ready, fall back to procedural continents.
  float proceduralLand = smoothstep(0.08, 0.22, fbm(vPosObj * 1.4));
  float land = mix(proceduralLand, mask.r, uMaskReady);
  float uz = mask.g * uMaskReady;
  float border = mask.b * uMaskReady;

  float n1 = fbm(vPosObj * 3.2) * 0.5 + 0.5;
  float n2 = fbm(vPosObj * 11.0 + 4.0) * 0.5 + 0.5;
  float lat = abs(vPosObj.y);

  vec3 ocean = mix(vec3(0.012, 0.058, 0.047), vec3(0.035, 0.13, 0.10), smoothstep(0.3, 0.85, n1));
  vec3 landCol = mix(vec3(0.10, 0.24, 0.16), vec3(0.28, 0.46, 0.26), smoothstep(0.35, 0.78, n1));
  // Drier belts in the subtropics/mid-latitudes, a stylised hint of deserts.
  float aridBand = smoothstep(0.22, 0.38, lat) * (1.0 - smoothstep(0.66, 0.78, lat));
  landCol = mix(landCol, vec3(0.55, 0.50, 0.34), aridBand * smoothstep(0.38, 0.72, n2) * 0.75);
  float ice = smoothstep(0.87, 0.95, lat + (n2 - 0.5) * 0.08);

  vec3 col = mix(ocean, landCol, land);
  col = mix(col, vec3(0.80, 0.86, 0.83), ice);

  vec3 lime = vec3(0.722, 0.953, 0.42);
  col = mix(col, lime * 0.92, uz * 0.88);

  float ndl = dot(n, sun);
  float day = smoothstep(-0.2, 0.55, ndl);
  vec3 lit = col * (0.14 + 1.08 * day);

  // Soft specular glint on water.
  vec3 h = normalize(sun + v);
  float spec = pow(max(dot(n, h), 0.0), 48.0) * (1.0 - land) * day;
  lit += vec3(0.62, 0.86, 0.72) * spec * 0.32;

  lit += vec3(0.55, 0.80, 0.62) * border * 0.16 * (0.3 + day);

  // Uzbekistan keeps a gentle glow even on the night side.
  float pulse = 0.5 + 0.5 * sin(uTime * 1.6);
  lit += lime * uz * (0.16 + 0.12 * pulse);

  // Atmospheric rim inside the disc: dusty amber 

--- components/ui/Button.js ---
import styles from './Button.module.css';

/**
 * Button / link with consistent states (hover, focus, active, disabled, loading).
 * Renders <a> when `href` is provided, otherwise <button>.
 */
export function Button({
  href,
  variant = 'primary',
  size = 'md',
  icon: Icon,
  iconPosition = 'end',
  loading = false,
  block = false,
  className = '',
  children,
  type = 'button',
  disabled,
  ...rest
}) {
  const cls = [
    styles.btn,
    styles[variant],
    styles[size],
    block ? styles.block : '',
    !children ? styles.iconOnly : '',
    loading ? styles.loading : '',
    className,
  ]
    .filter(Boolean)
    .join(' ');

  const iconEl = loading ? (
    <span className={styles.spinner} aria-hidden="true" />
  ) : Icon ? (
    <Icon
      className={`${styles.icon} ${iconPosition === 'end' ? styles.iconEnd : styles.iconStart}`}
      size={size === 'sm' ? 16 : 18}
      strokeWidth={2}
      aria-hidden="true"
    />
  ) : null;

  const content = (
    <>
      {iconPosition === 'start' && iconEl}
      {children && <span className={styles.label}>{children}</span>}
      {iconPosition === 'end' && iconEl}
    </>
  );

  if (href) {
    return (
      <a href={href} className={cls} {...rest}>
        {content}
      </a>
    );
  }

  return (
    <button
      type={type}
      className={cls}
      disabled={disabled || loading}
      aria-busy={loading || undefined}
      {...rest}
    >
      {content}
    </button>
  );
}


