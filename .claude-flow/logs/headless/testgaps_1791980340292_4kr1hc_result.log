s/progress.test.js)\nLargest surviving gap in a tested file. Untested reducer actions: `HYDRATE`, `SET_WEEKLY_GOAL`, `TOGGLE_CHECKLIST`, `CLEAR_PLAN`, `REMOVE_PROPOSAL`; untested selectors: `isInPlan`, `planStats`, `weekStart`; untested badges: `team-player`, `voice`, `clean-step`, `weekly`, `air-explorer`; `computePoints` proposal cap at `MAX_COUNTED_PROPOSALS`.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { reducer, INITIAL_STATE, computePoints, computeBadges, planStats, isInPlan } from '../features/progress/progress.js';\n\ntest('SET_WEEKLY_GOAL clamps to [1, 7]', () => {\n  let s = reducer(INITIAL_STATE, { type: 'SET_WEEKLY_GOAL', goal: 50 });\n  assert.equal(s.weeklyGoal, 7);\n  s = reducer(s, { type: 'SET_WEEKLY_GOAL', goal: 0 });\n  assert.equal(s.weeklyGoal, 1);\n});\n\ntest('TOGGLE_CHECKLIST adds then removes an index', () => {\n  let s = reducer(INITIAL_STATE, { type: 'TOGGLE_CHECKLIST', listId: 'l1', index: 2 });\n  assert.deepEqual(s.checklists.l1, [2]);\n  s = reducer(s, { type: 'TOGGLE_CHECKLIST', listId: 'l1', index: 2 });\n  assert.deepEqual(s.checklists.l1, []);\n});\n\ntest('computePoints caps proposal points at MAX_COUNTED_PROPOSALS', () => {\n  let s = INITIAL_STATE;\n  for (let i = 0; i < 5; i++) {\n    s = reducer(s, { type: 'ADD_PROPOSAL', proposal: { title: `Idea ${i}`, category: 'awareness' }, id: `i${i}`, now: '2026-10-01T00:00:00.000Z' });\n  }\n  assert.equal(computePoints(s).fromProposals, 45); // 3 × 15, not 5 × 15\n});\n\ntest('team-player, voice and clean-step badges earn on the right history', () => {\n  // TODO: build history entries with mode:'group' / effect:'awareness' / effect:'direct'\n  // and assert computeBadges(...).find(b => b.id === '...').earned === true/false at the boundary.\n});\n\ntest('planStats reports ratio 0 for an empty plan (no division by zero)', () => {\n  assert.deepEqual(planStats([]), { total: 0, done: 0, open: 0, ratio: 0 });\n});\n```\n\n### `lib/airQuality/waqi.js` (tests/waqi-and-proposal.test.js)\nUntested: exact `epaCategory` boundaries (50/51, 100/101, 150/151, 200/201, 300/301), malformed `city.geo`, attribution list truncated to 6, unknown `dominentpol`.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { epaCategory, normalizeWaqi } from '../lib/airQuality/waqi.js';\n\ntest('epaCategory boundaries are inclusive on the lower bound of each band', () => {\n  assert.equal(epaCategory(50).id, 'good');\n  assert.equal(epaCategory(51).id, 'moderate');\n  assert.equal(epaCategory(100).id, 'moderate');\n  assert.equal(epaCategory(101).id, 'usg');\n  assert.equal(epaCategory(300).id, 'very-unhealthy');\n  assert.equal(epaCategory(301).id, 'hazardous');\n});\n\ntest('missing or malformed station geo is an error, not a crash', () => {\n  const r = normalizeWaqi({ status: 'ok', data: { city: {}, iaqi: { pm25: { v: 10 } }, time: { iso: '2026-10-14T10:00:00Z' } } },\n    { id: 'tashkent', lat: 41.3, lon: 69.24 }, { maxStationDistanceKm: 40, staleAfterHours: 3 });\n  assert.equal(r.status, 'error');\n  assert.equal(r.reason, 'missing-station-location');\n});\n\ntest('attributions list is capped at 6 entries', () => {\n  // TODO: build a sample() with 10 valid https attributions, assert result.attributions.length === 6\n});\n\ntest('an unrecognised dominant pollutant code is reported as null', () => {\n  // TODO: sample() with dominentpol: 'co' (not in POLLUTANT_KEYS) → r.dominant === null\n});\n```\n\n### `features/initiatives/proposal.js` (tests/waqi-and-proposal.test.js)\n`toStoredProposal` is completely untested; title/description boundary lengths aren't checked.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { toStoredProposal, validateProposal, LIMITS, EMPTY_PROPOSAL } from '../features/initiatives/proposal.js';\n\ntest('toStoredProposal trims strings and coerces needsAdult/alias', () => {\n  const stored = toStoredProposal({ ...E