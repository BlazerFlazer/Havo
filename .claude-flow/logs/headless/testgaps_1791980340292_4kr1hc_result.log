        "code": "import { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { reducer, INITIAL_STATE, computePoints, computeBadges, planStats, isInPlan } from '../features/progress/progress.js';\n\ntest('SET_WEEKLY_GOAL clamps to [1, 7]', () => {\n  let s = reducer(INITIAL_STATE, { type: 'SET_WEEKLY_GOAL', goal: 50 });\n  assert.equal(s.weeklyGoal, 7);\n  s = reducer(s, { type: 'SET_WEEKLY_GOAL', goal: 0 });\n  assert.equal(s.weeklyGoal, 1);\n});\n\ntest('TOGGLE_CHECKLIST adds then removes an index', () => {\n  let s = reducer(INITIAL_STATE, { type: 'TOGGLE_CHECKLIST', listId: 'l1', index: 2 });\n  assert.deepEqual(s.checklists.l1, [2]);\n  s = reducer(s, { type: 'TOGGLE_CHECKLIST', listId: 'l1', index: 2 });\n  assert.deepEqual(s.checklists.l1, []);\n});\n\ntest('computePoints caps proposal points at MAX_COUNTED_PROPOSALS', () => {\n  let s = INITIAL_STATE;\n  for (let i = 0; i < 5; i++) {\n    s = reducer(s, { type: 'ADD_PROPOSAL', proposal: { title: `Idea ${i}`, category: 'awareness' }, id: `i${i}`, now: '2026-10-01T00:00:00.000Z' });\n  }\n  assert.equal(computePoints(s).fromProposals, 45); // 3 × 15, not 5 × 15\n});\n\ntest('team-player, voice and clean-step badges earn on the right history', () => {\n  // TODO: build history entries with mode:'group' / effect:'awareness' / effect:'direct'\n  // and assert computeBadges(...).find(b => b.id === '...').earned === true/false at the boundary.\n});\n\ntest('planStats reports ratio 0 for an empty plan (no division by zero)', () => {\n  assert.deepEqual(planStats([]), { total: 0, done: 0, open: 0, ratio: 0 });\n});"
