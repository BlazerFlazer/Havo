        "content": "Untested: unknown `budget` value, the `time<=2 && difficulty===1` nudge, tie-break by difficulty, custom `actions` fixture for the \"solo action suggested to a group\" caution branch.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { recommendActions } from '../features/actions/finder.js';\n\ntest('an unrecognised budget value is treated as the cheapest tier', () => {\n  const results = recommendActions({ time: 4, budget: 'bitcoin', setting: 'school', activity: 'organizing', mode: 'group' });\n  for (const { action } of results) assert.equal(action.cost, 'free');\n});\n\ntest('short time budget nudges easy actions ahead of equally-scored harder ones', () => {\n  const actions = [\n    { id: 'easy', settings: ['school'], activities: ['learning'], mode: 'solo', timeBucket: 1, cost: 'free', difficulty: 1 },\n    { id: 'hard', settings: ['school'], activities: ['learning'], mode: 'solo', timeBucket: 1, cost: 'free', difficulty: 3 },\n  ];\n  const results = recommendActions({ time: 1, budget: 'free', setting: 'school', activity: 'learning', mode: 'solo' }, actions);\n  assert.equal(results[0].action.id, 'easy');\n});\n\ntest('a solo action suggested to a group gets the \"usually done alone\" caution', () => {\n  const actions = [{ id: 'solo-only', settings: ['online'], activities: ['learning'], mode: 'solo', timeBucket: 4, cost: 'free', difficulty: 1 }];\n  const [r] = recommendActions({ time: 4, budget: 'free', setting: 'online', activity: 'learning', mode: 'group' }, actions);\n  assert.ok(r.cautions.some((c) => c.includes('в одиночку')));\n});\n```\n\n",
