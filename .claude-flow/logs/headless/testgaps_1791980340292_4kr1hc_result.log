ateTime reject invalid dates', () => {\n  assert.equal(formatDate('not-a-date'), '—');\n  assert.equal(formatDateTime('not-a-date'), '—');\n});\n\ntest('dayKey uses local calendar day, not UTC', () => {\n  assert.equal(dayKey(new Date(2026, 9, 14, 23, 59)), '2026-10-14');\n});\n\ntest('timeAgo buckets minutes/hours/days correctly', () => {\n  const now = Date.parse('2026-10-14T12:00:00Z');\n  assert.equal(timeAgo(now, now), 'только что');\n  assert.equal(timeAgo(now - 5 * 60000, now), '5 минут назад');\n  assert.equal(timeAgo(now - 3 * 3600000, now), '3 часа назад');\n  assert.equal(timeAgo(now - 2 * 86400000, now), '2 дня назад');\n  assert.equal(timeAgo('garbage', now), '—');\n});\n\ntest('daysUntil rejects malformed deadline strings', () => {\n  assert.equal(daysUntil('not-a-date'), null);\n  assert.equal(daysUntil('2026-02-30'), null); // nonsense calendar date — JS Date silently rolls over; worth locking down behavior\n});\n```\n\n### `features/actions/finder.js` (tests/finder.test.js)\nUntested: unknown `budget` value, the `time<=2 && difficulty===1` nudge, tie-break by difficulty, custom `actions` fixture for the \"solo action suggested to a group\" caution branch.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { recommendActions } from '../features/actions/finder.js';\n\ntest('an unrecognised budget value is treated as the cheapest tier', () => {\n  const results = recommendActions({ time: 4, budget: 'bitcoin', setting: 'school', activity: 'organizing', mode: 'group' });\n  for (const { action } of results) assert.equal(action.cost, 'free');\n});\n\ntest('short time budget nudges easy actions ahead of equally-scored harder ones', () => {\n  const actions = [\n    { id: 'easy', settings: ['school'], activities: ['learning'], mode: 'solo', timeBucket: 1, cost: 'free', difficulty: 1 },\n    { id: 'hard', settings: ['school'], activities: ['learning'], mode: 'solo', timeBucket: 1, cost: 'free', difficulty: 3 },\n  ]