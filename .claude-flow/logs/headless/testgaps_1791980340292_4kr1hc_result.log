        "code": "// tests/inversionSim.test.js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { buildLayout, createSim, step, settle, levelBand, explain } from '../features/problem/inversionSim.js';\n\ntest('buildLayout is deterministic for the same dimensions (seeded RNG)', () => {\n  assert.deepEqual(buildLayout(800, 400), buildLayout(800, 400));\n});\n\ntest('createSim starts at level 0 with no particles', () => {\n  const sim = createSim(buildLayout(800, 400));\n  assert.equal(sim.level, 0);\n  assert.equal(sim.particles.length, 0);\n});\n\ntest('settle with inversion+no-wind reaches a higher level than with wind and no inversion', () => {\n  const params = { inversion: true, wind: 0, rain: false, traffic: 3, heating: 3 };\n  const withInversion = createSim(buildLayout(800, 400));\n  settle(withInversion, params, 2000);\n  const withWind = createSim(buildLayout(800, 400));\n  settle(withWind, { ...params, inversion: false, wind: 2 }, 2000);\n  assert.ok(withInversion.level > withWind.level);\n});\n\ntest('zero sources never accumulate, regardless of weather', () => {\n  const sim = createSim(buildLayout(800, 400));\n  settle(sim, { inversion: true, wind: 0, rain: false, traffic: 0, heating: 0 }, 2000);\n  assert.ok(sim.level < 1);\n});\n\ntest('levelBand thresholds', () => {\n  assert.equal(levelBand(0).id, 'low');\n  assert.equal(levelBand(29.9).id, 'low');\n  assert.equal(levelBand(30).id, 'mid');\n  assert.equal(levelBand(59.9).id, 'mid');\n  assert.equal(levelBand(60).id, 'high');\n});\n\ntest('explain covers every branch without throwing', () => {\n  const cases = [\n    { traffic: 0, heating: 0, inversion: false, wind: 1, rain: false },\n    { traffic: 1, heating: 0, inversion: true, wind: 0, rain: false },\n    { traffic: 1, heating: 0, inversion: true, wind: 1, rain: false },\n    { traffic: 1, heating: 0, inversion: false, wind: 1, rain: true },\n    { traffic: 1, heating: 0, inversion: false, wind: 2, rain: false },\n    { traffic: 1, heating: 0, inversion: false, wind: 1, rain: false },\n  ];\n  for (const c of cases) assert.ok(typeof explain(c) === 'string' && explain(c).length > 10);\n});"
