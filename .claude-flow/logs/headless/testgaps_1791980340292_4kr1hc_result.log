        "content": "Untested exports: `formatNumber`, `formatDate`, `formatDateTime`, `dayKey`, `timeAgo`. Also `daysUntil`/`deadlineLabel` aren't checked against malformed input.\n\n```js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { formatNumber, formatDate, formatDateTime, dayKey, timeAgo, daysUntil } from '../lib/format.js';\n\ntest('formatNumber falls back to an em dash for non-finite values', () => {\n  assert.equal(formatNumber(NaN), '—');\n  assert.equal(formatNumber(Infinity), '—');\n  assert.equal(formatNumber(1234), '1 234');\n});\n\ntest('formatDate/formatDateTime reject invalid dates', () => {\n  assert.equal(formatDate('not-a-date'), '—');\n  assert.equal(formatDateTime('not-a-date'), '—');\n});\n\ntest('dayKey uses local calendar day, not UTC', () => {\n  assert.equal(dayKey(new Date(2026, 9, 14, 23, 59)), '2026-10-14');\n});\n\ntest('timeAgo buckets minutes/hours/days correctly', () => {\n  const now = Date.parse('2026-10-14T12:00:00Z');\n  assert.equal(timeAgo(now, now), 'только что');\n  assert.equal(timeAgo(now - 5 * 60000, now), '5 минут назад');\n  assert.equal(timeAgo(now - 3 * 3600000, now), '3 часа назад');\n  assert.equal(timeAgo(now - 2 * 86400000, now), '2 дня назад');\n  assert.equal(timeAgo('garbage', now), '—');\n});\n\ntest('daysUntil rejects malformed deadline strings', () => {\n  assert.equal(daysUntil('not-a-date'), null);\n  assert.equal(daysUntil('2026-02-30'), null); // nonsense calendar date — JS Date silently rolls over; worth locking down behavior\n});\n```\n\n",
