node:test';\nimport assert from 'node:assert/strict';\nimport { actionToPlanItem, initiativeToPlanItem } from '../features/planner/planItems.js';\n\ntest('actionToPlanItem copies the fields the plan needs', () => {\n  const action = { id: 'a1', title: 'Walk', category: 'personal', effect: 'direct', mode: 'solo', difficulty: 1 };\n  assert.deepEqual(actionToPlanItem(action), {\n    kind: 'action', refId: 'a1', title: 'Walk', category: 'personal', effect: 'direct', mode: 'solo', difficulty: 1,\n  });\n});\n\ntest('initiativeToPlanItem maps category to an effect and always defaults to group mode', () => {\n  const initiative = { id: 'i1', name: 'Clean Air Week', category: 'awareness', difficulty: 2 };\n  const item = initiativeToPlanItem(initiative);\n  assert.equal(item.effect, 'awareness');\n  assert.equal(item.mode, 'group');\n});\n\ntest('initiativeToPlanItem falls back to \"community\" effect for an unmapped category', () => {\n  const item = initiativeToPlanItem({ id: 'i2', name: 'Mystery', category: 'unknown-category', difficulty: 1 });\n  assert.equal(item.effect, 'community');\n});\n```\n\n### `features/problem/inversionSim.js` — no test file at all; it's the densest untested logic in the repo\n```js\n// tests/inversionSim.test.js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { buildLayout, createSim, step, settle, levelBand, explain } from '../features/problem/inversionSim.js';\n\ntest('buildLayout is deterministic for the same dimensions (seeded RNG)', () => {\n  assert.deepEqual(buildLayout(800, 400), buildLayout(800, 400));\n});\n\ntest('createSim starts at level 0 with no particles', () => {\n  const sim = createSim(buildLayout(800, 400));\n  assert.equal(sim.level, 0);\n  assert.equal(sim.particles.length, 0);\n});\n\ntest('settle with inversion+no-wind reaches a higher level than with wind and no inversion', () => {\n  const params = { inversion: true, wind: 0, rain: false, traffic: 3, heating: 3 };\n  const withInversion = createSim(buildLayout(800, 400));\n  settle(withInversion, params, 2000);\n  const withWind = createSim(buildLayout(800, 400));\n  settle(withWind, { ...params, inversion: false, wind: 2 }, 2000);\n  assert.ok(withInversion.level > withWind.level);\n});\n\ntest('zero sources never accumulate, regardless of weather', () => {\n  const sim = createSim(buildLayout(800, 400));\n  settle(sim, { inversion: true, wind: 0, rain: false, traffic: 0, heating: 0 }, 2000);\n  assert.ok(sim.level < 1);\n});\n\ntest('levelBand thresholds', () => {\n  assert.equal(levelBand(0).id, 'low');\n  assert.equal(levelBand(29.9).id, 'low');\n  assert.equal(levelBand(30).id, 'mid');\n  assert.equal(levelBand(59.9).id, 'mid');\n  assert.equal(levelBand(60).id, 'high');\n});\n\ntest('explain covers every branch without throwing', () => {\n  const cases = [\n    { traffic: 0, heating: 0, inversion: false, wind: 1, rain: false },\n    { traffic: 1, heating: 0, inversion: true, wind: 0, rain: false },\n    { traffic: 1, heating: 0, inversion: true, wind: 1, rain: false },\n    { traffic: 1, heating: 0, inversion: false, wind: 1, rain: true },\n    { traffic: 1, heating: 0, inversion: false, wind: 2, rain: false },\n    { traffic: 1, heating: 0, inversion: false, wind: 1, rain: false },\n  ];\n  for (const c of cases) assert.ok(typeof explain(c) === 'string' && explain(c).length > 10);\n});\n```\n\n### `features/actions/actionSheetStore.js` / `features/tools/toolTabStore.js` / `features/feedback/toast.js`\nThese are plain module-level stores built on `subscribe`/listener sets — the subscribe/emit contract is pure JS and testable **without React** by calling the exported functions directly and asserting the listener fires. Only `useOpenActionId`/`useToolTab`/`useToast` themselves (the `useSyncExternalStore` wrappers) need a component-test harness; the store logic doesn't.\n\n```js\n// tests/stores.test.js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { openAction, closeAction } from '../features/actions/actionSheetStore.js';\nimport { setToolTab } from '../features/tools/toolTabStore.js';\nimport { showToast, dismissToast } from '../features/feedback/toast.js';\n\n// Note: these modules only export the setter functions and a React hook for\n// reading state — there's no plain getter. To unit test without React, either\n// export a `getSnapshot`-equivalent for tests, or spy via a fake listener.\n\ntest('openAction/closeAction notify subscribers', () => {\n  // TODO: once a non-hook getter exists (or by reaching into module internals via\n  // a test-only export), assert openAction('x') then closeAction() round-trips.\n});\n\ntest('showToast replaces an in-flight toast and auto-dismisses after `duration`', (t) => {\n  t.mock.timers.enable({ apis: ['setTimeout'] });\n  // TODO: showToast('a'); showToast('b') immediately after → only 'b' should be live.\n  // Advance timers past `duration` and assert the toast cleared.\n});\n```\n*(Flagging: these three stores currently offer no way to read `openId`/`active`/`current` outside the React hook. Worth adding a plain `getOpenActionId()`-style export purely so tests don't need a DOM — small, low-risk refactor.)*\n\n### `data/cities.js`, `config/dataSources.js`\n```js\n// add to tests/content.test.js\nimport { getCityById } from '../data/cities.js';\nimport { getSource } from '../config/dataSources.js';\n\ntest('getCityById returns null for an unknown id', () => {\n  assert.equal(getCityById('atlantis'), null);\n});\n\ntest('getSource returns null for an unknown id', () => {\n  assert.equal(getSource('nonexistent'), null);\n});\n```\n\n### `features/impact/transportRows.js`\n```js\n// tests/transportRows.test.js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { TRANSPORT_ROWS } from '../features/impact/transportRows.js';\nimport { EMISSION_FACTORS } from '../config/dataSources.js';\n\ntest('transport comparison rows stay consistent with