quality?city=atlantis'));\n  assert.equal(res.status, 400);\n});\n\ntest('no token configured → status \"unconfigured\", 200', async () => {\n  delete process.env.WAQI_API_TOKEN;\n  const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n  assert.equal((await res.json()).status, 'unconfigured');\n});\n\ntest('upstream non-2xx → 502 with reason', async (t) => {\n  process.env.WAQI_API_TOKEN = 'test';\n  t.mock.method(globalThis, 'fetch', async () => new Response('', { status: 500 }));\n  const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n  assert.equal(res.status, 502);\n  assert.equal((await res.json()).reason, 'upstream-500');\n});\n\ntest('fetch timeout → { status: \"error\", reason: \"timeout\" }', async (t) => {\n  process.env.WAQI_API_TOKEN = 'test';\n  t.mock.method(globalThis, 'fetch', async () => { throw Object.assign(new Error(), { name: 'TimeoutError' }); });\n  const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n  assert.equal((await res.json()).reason, 'timeout');\n});\n```\n\n**`features/progress/store.js`** — untested end-to-end: hydration from `localStorage`, persistence after `dispatch`, `isPersistenceAvailable()` flipping to `false` on a write failure, and cross-tab sync via the `storage` event. Needs a minimal `window`/`localStorage` stub (no full jsdom required for this one, since the module only touches `localStorage` and `addEventListener('storage', …)`).\n\n```js\n// tests/progress-store.test.js\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\n\nfunction fakeWindow() {\n  const store = new Map();\n  const listeners = {};\n  return {\n    innerWidth: 0,\n    localStorage: {\n      getItem: (k) => (store.has(k) ? store.get(k) : null),\n      setItem: (k, v) => store.set(k, v),\n    },\n    addEventListener: (ev, fn) => { (listeners[ev] ??= []).push(fn); },\n    removeEventListener: () => {},\n    _emitStorage: (key, value) => listeners.storage?.forEach((fn) => fn({ key })),\n  };\n}\n\ntest('addToPlan persists to localStorage and is readable after a fresh import', async () => {\n  global.window = fakeWindow();\n  const { havoActions, useHavoState } = await import('../features/progress/store.js?t=' + Date.now());\n  havoActions.addToPlan({ id: 'x', refId: 'r', title: 't', category: 'c', effect: 'direct', mode: 'solo', difficulty: 1 });\n  // TODO: assert window.localStorage.getItem('havo:v1') round-trips to a state with 1 plan item.\n  delete global.window;\n});\n```\n*(Module-level mutable `state`/`loaded` singletons make this awkward to isolate between tests — worth noting as a design constraint for testability, not just a missing-test gap.)*\n\n---\n\n## 5. Structural gap: no component or hook test harness\n\nEvery React component (`components/**`, `features/**/*.js` that render JSX — `Quiz`, `Planner`, `ActionFinder`, `ActionLibrary`, `ImpactCalculator`, `AirDashboard`, `ProposalForm`, `InitiativeList`, `ProgressDashboard`, `ActionSheet`, `Sheet`, `ConfirmDialog`, `Button`, `Toaster`, etc.) and every hook (`useDialogBehavior`, `useMediaQuery`, `useInViewport`, `useIsClient`, `useActiveSection`) has **no test coverage and no way to get any**, because `devDependencies` has only `eslint`/`eslint-config-next` — no `jsdom`, no `@testing-library/react`, no React-aware test environment.\n\nHighest-value targets if this infra is added (ranked by logic density, not visual complexity):\n1. `Quiz.js` — scoring (`resultMessage` thresholds), answer/mistake tracking, `recordQuiz` call on finish.\n2. `features/initiatives/ProposalForm.js` — wires `validateProposal`/`containsContact` to form state; worth an interaction test (type a phone number → blocked submit).\n3. `features/planner/Planner.js` + `AddToPlanButton.js` — duplicate-add prevention, complete/un-complete toggling against the real store.\n4. `useDialogBehavior` — focus trap and Escape-to-close are exactly the kind of logic that silently regresses without a test.\n\nSuggested skeleton once infra exists (`npm i -D jsdom @testing-library/react` + a `--test-reporter`/env flag, or switch the runner to Vitest for jsdom support):\n\n```js\n// tests/quiz.component.test.jsx  (needs jsdom + @testing-library/react)\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { render, screen, fireEvent } from '@testing-library/react';\nimport { Quiz } from '../features/quiz/Quiz.js';\n\ntest('selecting the correct answer and submitting shows positive feedback', () => {\n  render(<Quiz />);\n  // TODO: fireEvent.click the correct radio, submit, assert \"Верно!\" renders.\n});\n```\n\n---\n\n## Priority punch list\n\n1. **Quick wins, no infra needed** — `lib/storage.js`, `features/planner/planItems.js`, `data/cities.js`/`getSource`, `transportRows.js` content check, the missing-edge-case additions to `format.js`/`impact.js`/`waqi.js`/`proposal.js` tests above. All copy-paste-ready from this report.\n2. **`features/problem/inversionSim.js`** — zero coverage on the most complex pure-logic file in the repo; `levelBand`/`explain` alone are cheap, high-value tests.\n3. **`features/progress/progress.js`** reducer — fill in `HYDRATE`, `SET_WEEKLY_GOAL`, `TOGGLE_CHECKLIST`, `CLEAR_PLAN`, `REMOVE_PROPOSAL`, and the 5 untested badges; this file guards user-visible points/badges logic.\n4. **Unblock `app/api/air-quality/route.js`** — add a path-alias resolution so it's importable under `node --test`, then land the 5 branch tests above. This is the only server boundary in the app and currently has no safety net.\n5. **Decide on component-test infra** — even a minimal `jsdom` + `@testing-library/react` setup covering `Quiz`, `ProposalForm`, and `useDialogBehavior` would close the largest blind spot (everything users actually click).\n",
