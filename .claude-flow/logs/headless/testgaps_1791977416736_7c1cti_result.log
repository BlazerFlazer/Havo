        "code": "// tests/features/impact/impact.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { getAlternative, savingPerKm, calculateImpact, roundKg, CALC_LIMITS } from '../../../features/impact/impact.js';\n\ndescribe('getAlternative', () => {\n  test('unknown id falls back to the first alternative (walk)', () => {\n    assert.equal(getAlternative('spaceship').id, 'walk');\n  });\n});\n\ndescribe('savingPerKm', () => {\n  test('walk/bike: full carFactor avoided, both ends of the range equal', () => {\n    assert.deepEqual(savingPerKm('walk', 249), [249, 249]);\n  });\n  test('bus: range from (carFactor - busFactor) to carFactor, clamped at 0', () => {\n    const [low, high] = savingPerKm('bus', 80); // carFactor < bus factor (104)\n    assert.equal(low, 0); // Math.max(0, 80-104)\n    assert.equal(high, 80);\n  });\n  test('carpool: single value at 50% share, not a range', () => {\n    assert.deepEqual(savingPerKm('carpool', 200), [100, 100]);\n  });\n});\n\ndescribe('calculateImpact — clamping', () => {\n  test('out-of-range inputs are clamped to CALC_LIMITS, not silently used as-is', () => {\n    const r = calculateImpact({ tripsPerWeek: 999, km: -5, weeks: 0 });\n    assert.equal(r.inputs.tripsPerWeek, CALC_LIMITS.trips.max);\n    assert.equal(r.inputs.km, CALC_LIMITS.km.min);\n    assert.equal(r.inputs.weeks, CALC_LIMITS.weeks.min);\n  });\n  test('non-finite inputs (NaN/undefined) fall back to the min, not NaN propagation', () => {\n    const r = calculateImpact({ tripsPerWeek: NaN });\n    assert.equal(Number.isFinite(r.inputs.tripsPerWeek), true);\n  });\n});\n\ndescribe('calculateImpact — series + derived fields', () => {\n  test('isRange is false for walk (single-point saving) and true for bus', () => {\n    assert.equal(calculateImpact({ alternative: 'walk' }).isRange, false);\n    assert.equal(calculateImpact({ alternative: 'bus', carFactor: 200 }).isRange, true);\n  });\n  test('activeHours is null for an alternative without speedKmh (carpool)', () => {\n    assert.equal(calculateImpact({ alternative: 'carpool' }).activeHours, null);\n  });\n  test('series has one column per week when weeks <= 12', () => {\n    const r = calculateImpact({ weeks: 6 });\n    assert.equal(r.series.length, 6);\n    assert.equal(r.series.at(-1).week, 6);\n  });\n  test('series collapses to 12 evenly spaced checkpoints when weeks > 12', () => {\n    const r = calculateImpact({ weeks: 52 });\n    assert.equal(r.series.length, 12);\n    assert.equal(r.series.at(-1).week, 52);\n  });\n});\n\ndescribe('roundKg', () => {\n  test('non-finite or non-positive values round to 0', () => {\n    assert.equal(roundKg(NaN), 0);\n    assert.equal(roundKg(-5), 0);\n    assert.equal(roundKg(0), 0);\n  });\n  test('values under 1kg keep one decimal of precision', () => {\n    assert.equal(roundKg(0.37), 0.4);\n  });\n  test('values >= 1kg round to 2 significant figures', () => {\n    assert.equal(roundKg(1234), 1200);\n    assert.equal(roundKg(87), 87);\n  });\n});"
