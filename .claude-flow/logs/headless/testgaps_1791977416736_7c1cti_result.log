      {
        "title": "1. `lib/format.js` — untested, no edge cases covered",
        "content": "\nGaps: Russian plural teen-exception (11–19), `Number.isFinite` guards, invalid-date fallbacks, `now` injection for determinism.\n\n```js\n// tests/lib/format.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  plural, pluralize, formatNumber, formatDate, formatDateTime,\n  dayKey, timeAgo, daysUntil, deadlineLabel,\n} from '../../lib/format.js';\n\ndescribe('plural', () => {\n  const forms = ['день', 'дня', 'дней'];\n  test('1 -> singular, 21 -> singular (not just n%10)', () => {\n    assert.equal(plural(1, forms), 'день');\n    assert.equal(plural(21, forms), 'день');\n  });\n  test('teens 11-19 are always the plural-of-many form', () => {\n    assert.equal(plural(11, forms), 'дней');\n    assert.equal(plural(14, forms), 'дней');\n    assert.equal(plural(19, forms), 'дней');\n  });\n  test('2-4 and 22-24 use the \"few\" form', () => {\n    assert.equal(plural(2, forms), 'дня');\n    assert.equal(plural(22, forms), 'дня');\n  });\n  test('0, 5-20, 25+ use the \"many\" form', () => {\n    assert.equal(plural(0, forms), 'дней');\n    assert.equal(plural(5, forms), 'дней');\n  });\n  test('negative numbers use abs value', () => {\n    assert.equal(plural(-1, forms), 'день');\n  });\n});\n\ndescribe('formatNumber', () => {\n  test('non-finite values render as em dash', () => {\n    assert.equal(formatNumber(NaN), '—');\n    assert.equal(formatNumber(Infinity), '—');\n  });\n  test('respects maximumFractionDigits and caches formatter per precision', () => {\n    assert.equal(formatNumber(3.14159, 2), '3,14');\n  });\n});\n\ndescribe('formatDate / formatDateTime', () => {\n  test('invalid date input renders as em dash', () => {\n    assert.equal(formatDate('not-a-date'), '—');\n    assert.equal(formatDateTime(NaN), '—');\n  });\n  test('accepts Date, ISO string and timestamp number equivalently', () => {\n    const d = new Date(2026, 0, 15);\n    assert.equal(formatDate(d), formatDate(d.toISOString()));\n  });\n});\n\ndescribe('dayKey', () => {\n  test('pads single-digit month/day', () => {\n    assert.equal(dayKey(new Date(2026, 0, 5)), '2026-01-05');\n  });\n  test('uses local time, not UTC', () => {\n    // Regression target: a Date just after local midnight must not roll back a day under UTC conversion.\n  });\n});\n\ndescribe('timeAgo', () => {\n  const now = new Date(2026, 9, 14, 12, 0, 0).getTime();\n  test('< 1 minute -> \"только что\"', () => {\n    assert.equal(timeAgo(now - 30_000, now), 'только что');\n  });\n  test('boundary at 60 minutes switches to hours', () => {\n    assert.equal(timeAgo(now - 59 * 60_000, now).includes('минут'), true);\n    assert.equal(timeAgo(now - 60 * 60_000, now).includes('час'), true);\n  });\n  test('boundary at 24 hours switches to days', () => {\n    assert.equal(timeAgo(now - 23 * 3600_000, now).includes('час'), true);\n    assert.equal(timeAgo(now - 24 * 3600_000, now).includes('день') || timeAgo(now - 24 * 3600_000, now).includes('дня'), true);\n  });\n  test('invalid timestamp renders em dash', () => {\n    assert.equal(timeAgo('garbage', now), '—');\n  });\n  test('GAP: future timestamps (clock skew) collapse to \"только что\" instead of signalling the future', () => {\n    // diffMin is negative -> `< 1` is true. Decide if this is desired; write the assertion either way.\n    assert.equal(timeAgo(now + 5 * 60_000, now), 'только что');\n  });\n});\n\ndescribe('daysUntil / deadlineLabel', () => {\n  const now = new Date(2026, 9, 14);\n  test('null/empty deadline -> null', () => {\n    assert.equal(daysUntil(null, now), null);\n    assert.equal(daysUntil('', now), null);\n  });\n  test('malformed deadline string -> null, not NaN', () => {\n    assert.equal(daysUntil('2026-13', now), null);\n  });\n  test('today -> 0, tomorrow -> 1, yesterday -> -1', () => {\n    assert.equal(daysUntil('2026-10-14', now), 0);\n    assert.equal(daysUntil('2026-10-15', now), 1);\n    assert.equal(daysUntil('2026-10-13', now), -1);\n  });\n  test('deadlineLabel tones: danger/warn/warn/neutral', () => {\n    assert.equal(deadlineLabel('2026-10-13', now).tone, 'danger');\n    assert.equal(deadlineLabel('2026-10-14', now).tone, 'warn');\n    assert.equal(deadlineLabel('2026-10-15', now).tone, 'warn');\n    assert.equal(deadlineLabel('2026-10-20', now).tone, 'neutral');\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "2. `lib/storage.js` — untested, SSR branch is the only one covered \"for free\"",
        "content": "\nGap: in plain Node, `window` is `undefined`, so `readJSON`/`writeJSON` always take the early-return branch today. The actual try/catch defensive behavior (corrupted JSON, quota errors) is **completely unexercised**. Needs a minimal `globalThis.window` stub.\n\n```js\n// tests/lib/storage.test.js\nimport { test, describe, beforeEach, afterEach } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { readJSON, writeJSON, createId } from '../../lib/storage.js';\n\nfunction installFakeWindow(store = new Map()) {\n  globalThis.window = {\n    localStorage: {\n      getItem: (k) => (store.has(k) ? store.get(k) : null),\n      setItem: (k, v) => store.set(k, v),\n    },\n  };\n  return store;\n}\n\ndescribe('readJSON / writeJSON (SSR)', () => {\n  test('returns null/false when window is undefined (server render)', () => {\n    delete globalThis.window;\n    assert.equal(readJSON('x'), null);\n    assert.equal(writeJSON('x', { a: 1 }), false);\n  });\n});\n\ndescribe('readJSON / writeJSON (browser)', () => {\n  afterEach(() => { delete globalThis.window; });\n\n  test('round-trips a value', () => {\n    installFakeWindow();\n    writeJSON('k', { a: 1 });\n    assert.deepEqual(readJSON('k'), { a: 1 });\n  });\n  test('missing key returns null', () => {\n    installFakeWindow();\n    assert.equal(readJSON('missing'), null);\n  });\n  test('corrupted JSON in storage does not throw, returns null', () => {\n    const store = installFakeWindow();\n    store.set('k', '{not json');\n    assert.equal(readJSON('k'), null);\n  });\n  test('quota/exception on setItem is swallowed, returns false', () => {\n    globalThis.window = { localStorage: { setItem() { throw new DOMException('quota', 'QuotaExceededError'); }, getItem: () => null } };\n    assert.equal(writeJSON('k', {}), false);\n  });\n});\n\ndescribe('createId', () => {\n  test('uses crypto.randomUUID when available', () => {\n    const id = createId('plan');\n    assert.match(id, /^plan-[0-9a-z]+-[0-9a-z]{8}$/);\n  });\n  test('falls back to Math.random when crypto.randomUUID is unavailable', () => {\n    const original = globalThis.crypto;\n    // @ts-ignore\n    globalThis.crypto = undefined;\n    const id = createId('plan');\n    assert.match(id, /^plan-[0-9a-z]+-[0-9a-z]+$/);\n    globalThis.crypto = original;\n  });\n  test('two calls in the same tick do not collide', () => {\n    const a = createId('x'), b = createId('x');\n    assert.notEqual(a, b);\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "3. `lib/airQuality/waqi.js` — untested, highest-risk parser in the app",
        "content": "\nUntested branches: malformed API payload, out-of-range station, stale data, pollutant/attribution sanitization, and — notably — `safeUrl`'s protocol allowlist, which is the only thing standing between an upstream-controlled `url` field and an `<a href>` in the UI.\n\n```js\n// tests/lib/airQuality/waqi.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { haversineKm, normalizeWaqi, epaCategory } from '../../../lib/airQuality/waqi.js';\n\nconst city = { id: 'tashkent', lat: 41.2995, lon: 69.2401 };\nconst opts = { maxStationDistanceKm: 40, staleAfterHours: 3, now: Date.parse('2026-10-14T12:00:00Z') };\n\ndescribe('haversineKm', () => {\n  test('distance from a point to itself is 0', () => {\n    assert.equal(haversineKm(41, 69, 41, 69), 0);\n  });\n  test('matches a known reference distance within tolerance', () => {\n    const km = haversineKm(41.2995, 69.2401, 39.6542, 66.9597); // Tashkent -> Samarkand\n    assert.ok(Math.abs(km - 266) < 5);\n  });\n});\n\ndescribe('normalizeWaqi — malformed input', () => {\n  test('non-ok status returns error with API-provided reason string', () => {\n    const r = normalizeWaqi({ status: 'error', data: 'Invalid key' }, city, opts);\n    assert.deepEqual(r, { status: 'error', reason: 'Invalid key' });\n  });\n  test('missing/invalid payload returns generic error reason', () => {\n    assert.equal(normalizeWaqi(null, city, opts).reason, 'invalid-response');\n    assert.equal(normalizeWaqi({ status: 'ok', data: null }, city, opts).reason, 'invalid-response');\n  });\n  test('missing station geo -> missing-station-location', () => {\n    const r = normalizeWaqi({ status: 'ok', data: { city: {} } }, city, opts);\n    assert.equal(r.reason, 'missing-station-location');\n  });\n  test('missing/invalid timestamp -> missing-timestamp', () => {\n    const r = normalizeWaqi({ status: 'ok', data: { city: { geo: [41.3, 69.24] }, time: {} } }, city, opts);\n    assert.equal(r.reason, 'missing-timestamp');\n  });\n});\n\ndescribe('normalizeWaqi — station distance gating', () => {\n  test('station beyond maxStationDistanceKm -> no-station, distance rounded to int', () => {\n    const r = normalizeWaqi(\n      { status: 'ok', data: { city: { name: 'Far', geo: [35, 69] }, time: { iso: '2026-10-14T10:00:00Z' } } },\n      city, opts,\n    );\n    assert.equal(r.status, 'no-station');\n    assert.equal(Number.isInteger(r.station.distanceKm), true);\n  });\n});\n\ndescribe('normalizeWaqi — data completeness', () => {\n  function payload(overrides = {}) {\n    return {\n      status: 'ok',\n      data: {\n        city: { name: 'Tashkent Station', geo: [41.3, 69.24], url: 'https://aqicn.org/city/tashkent' },\n        time: { iso: '2026-10-14T11:00:00Z' },\n        aqi: 85,\n        dominentpol: 'pm25',\n        iaqi: { pm25: { v: 84.6 }, pm10: { v: 40.2 } },\n        attributions: [{ name: 'Source', url: 'https://example.com' }],\n        ...overrides,\n      },\n    };\n  }\n\n  test('no aqi and no iaqi entries -> no-data', () => {\n    const r = normalizeWaqi(payload({ aqi: 'bad', iaqi: {} }), city, opts);\n    assert.equal(r.status, 'no-data');\n  });\n\n  test('happy path: rounds indices, flags dominant pollutant, computes staleness', () => {\n    const r = normalizeWaqi(payload(), city, opts);\n    assert.equal(r.status, 'ok');\n    assert.equal(r.indices.pm25, 85);\n    assert.equal(r.dominant, 'pm25');\n    assert.equal(r.stale, false);\n  });\n\n  test('dominentpol outside the known pollutant keys is dropped to null', () => {\n    const r = normalizeWaqi(payload({ dominentpol: 'co' }), city, opts);\n    assert.equal(r.dominant, null);\n  });\n\n  test('observation older than staleAfterHours is flagged stale', () => {\n    const r = normalizeWaqi(payload({ time: { iso: '2026-10-14T06:00:00Z' } }), city, opts); // 6h before `now`\n    assert.equal(r.stale, true);\n  });\n\n  test('SECURITY: non-http(s) attribution/station URLs are dropped (no javascript: URLs reach the UI)', () => {\n    const r = normalizeWaqi(\n      payload({\n        city: { name: 'X', geo: [41.3, 69.24], url: 'javascript:alert(1)' },\n        attributions: [{ name: 'Bad', url: 'javascript:alert(1)' }, { name: 'Good', url: 'https://ok.example' }],\n      }),\n      city, opts,\n    );\n    assert.equal(r.station.url, null);\n    assert.equal(r.attributions.length, 1);\n    assert.equal(r.attributions[0].name, 'Good');\n  });\n\n  test('attributions are capped at 6 and entries missing name/url are filtered', () => {\n    const many = Array.from({ length: 10 }, (_, i) => ({ name: `A${i}`, url: 'https://example.com' }));\n    const r = normalizeWaqi(payload({ attributions: [...many, { name: '', url: 'https://x' }] }), city, opts);\n    assert.equal(r.attributions.length, 6);\n  });\n\n  test('station name is truncated to 160 chars', () => {\n    const r = normalizeWaqi(payload({ city: { name: 'x'.repeat(300), geo: [41.3, 69.24] } }), city, opts);\n    assert.equal(r.station.name.length, 160);\n  });\n});\n\ndescribe('epaCategory', () => {\n  test('non-numeric/NaN input -> null', () => {\n    assert.equal(epaCategory(null), null);\n    assert.equal(epaCategory(NaN), null);\n  });\n  test('category boundaries (50/51, 100/101, 150/151, 200/201, 300/301)', () => {\n    assert.equal(epaCategory(50).id, 'good');\n    assert.equal(epaCategory(51).id, 'moderate');\n    assert.equal(epaCategory(100).id, 'moderate');\n    assert.equal(epaCategory(101).id, 'usg');\n    assert.equal(epaCategory(300).id, 'very-unhealthy');\n    assert.equal(epaCategory(301).id, 'hazardous');\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "4. `features/progress/progress.js` — reducer/sanitizer, zero coverage",
        "content": "\nThis is the biggest gap and the highest-value one: it sanitizes untrusted localStorage content and drives points/badges/streaks shown to the user.\n\n```js\n// tests/features/progress/progress.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  INITIAL_STATE, reducer, sanitizeState, isInPlan,\n  computePoints, computeStreak, weekStart, completionsInWeek,\n  computeBadges, computeMilestones, planStats, POINTS_BY_DIFFICULTY,\n} from '../../../features/progress/progress.js';\n\ndescribe('sanitizeState', () => {\n  test('non-object input returns a fresh copy of INITIAL_STATE', () => {\n    assert.deepEqual(sanitizeState(null), INITIAL_STATE);\n    assert.deepEqual(sanitizeState('garbage'), INITIAL_STATE);\n  });\n  test('plan items missing id or refId are dropped silently', () => {\n    const s = sanitizeState({ plan: [{ title: 'no id' }, { id: 'a', refId: 'b' }] });\n    assert.equal(s.plan.length, 1);\n  });\n  test('checklist entries are filtered to integers in [0,50)', () => {\n    const s = sanitizeState({ checklists: { l1: [0, 3, -1, 2.5, 'x', 60] } });\n    assert.deepEqual(s.checklists.l1, [0, 3]);\n  });\n  test('weeklyGoal is clamped into WEEKLY_GOAL_RANGE', () => {\n    assert.equal(sanitizeState({ weeklyGoal: 0 }).weeklyGoal, 1);\n    assert.equal(sanitizeState({ weeklyGoal: 99 }).weeklyGoal, 7);\n    assert.equal(sanitizeState({ weeklyGoal: 2.5 }).weeklyGoal, 3); // not an integer -> fallback default\n  });\n  test('quiz.bestScore of wrong type falls back to null rather than coercing', () => {\n    assert.equal(sanitizeState({ quiz: { bestScore: '5' } }).quiz.bestScore, null);\n  });\n});\n\ndescribe('reducer — ADD_PLAN_ITEM', () => {\n  test('ignores a duplicate (same kind+refId already in plan)', () => {\n    const base = reducer(INITIAL_STATE, { type: 'ADD_PLAN_ITEM', item: { kind: 'action', refId: 'r1', title: 'T' }, id: 'p1', now: 'n' });\n    const again = reducer(base, { type: 'ADD_PLAN_ITEM', item: { kind: 'action', refId: 'r1', title: 'dup' }, id: 'p2', now: 'n' });\n    assert.equal(again, base); // same reference -> no-op\n  });\n  test('rejects an item missing refId (sanitizePlanItem returns null)', () => {\n    const next = reducer(INITIAL_STATE, { type: 'ADD_PLAN_ITEM', item: { kind: 'action', title: 'no refId' }, id: 'p1', now: 'n' });\n    assert.equal(next, INITIAL_STATE);\n  });\n});\n\ndescribe('reducer — TOGGLE_COMPLETE', () => {\n  const withItem = reducer(INITIAL_STATE, {\n    type: 'ADD_PLAN_ITEM', item: { kind: 'action', refId: 'r1', title: 'T', difficulty: 2 }, id: 'p1', now: 'n0',\n  });\n  test('unknown plan id is a no-op', () => {\n    assert.equal(reducer(withItem, { type: 'TOGGLE_COMPLETE', id: 'missing', historyId: 'h', now: 'n' }), withItem);\n  });\n  test('completing awards POINTS_BY_DIFFICULTY[difficulty] and appends history', () => {\n    const done = reducer(withItem, { type: 'TOGGLE_COMPLETE', id: 'p1', historyId: 'h1', now: 'n1' });\n    assert.equal(done.history[0].points, POINTS_BY_DIFFICULTY[2]);\n    assert.equal(done.plan[0].completedAt, 'n1');\n  });\n  test('uncompleting removes the matching history entry', () => {\n    const done = reducer(withItem, { type: 'TOGGLE_COMPLETE', id: 'p1', historyId: 'h1', now: 'n1' });\n    const undone = reducer(done, { type: 'TOGGLE_COMPLETE', id: 'p1', historyId: 'h2', now: 'n2' });\n    assert.equal(undone.history.length, 0);\n    assert.equal(undone.plan[0].completedAt, null);\n  });\n  test('unknown difficulty falls back to 10 points', () => {\n    const weird = reducer(INITIAL_STATE, { type: 'ADD_PLAN_ITEM', item: { kind: 'action', refId: 'r2', title: 'T', difficulty: 99 }, id: 'p2', now: 'n0' });\n    const done = reducer(weird, { type: 'TOGGLE_COMPLETE', id: 'p2', historyId: 'h', now: 'n' });\n    assert.equal(done.history[0].points, 10);\n  });\n});\n\ndescribe('reducer — UPDATE_PLAN_ITEM', () => {\n  const withItem = reducer(INITIAL_STATE, { type: 'ADD_PLAN_ITEM', item: { kind: 'action', refId: 'r1', title: 'T' }, id: 'p1', now: 'n0' });\n  test('note is truncated to MAX_NOTE_LENGTH', () => {\n    const next = reducer(withItem, { type: 'UPDATE_PLAN_ITEM', id: 'p1', patch: { note: 'x'.repeat(500) } });\n    assert.equal(next.plan[0].note.length, 280);\n  });\n  test('malformed deadline string is rejected to null, not stored as-is', () => {\n    const next = reducer(withItem, { type: 'UPDATE_PLAN_ITEM', id: 'p1', patch: { deadline: 'tomorrow' } });\n    assert.equal(next.plan[0].deadline, null);\n  });\n  test('partial patch (deadline only) leaves note untouched', () => {\n    const withNote = reducer(withItem, { type: 'UPDATE_PLAN_ITEM', id: 'p1', patch: { note: 'hi' } });\n    const next = reducer(withNote, { type: 'UPDATE_PLAN_ITEM', id: 'p1', patch: { deadline: '2026-12-01' } });\n    assert.equal(next.plan[0].note, 'hi');\n  });\n});\n\ndescribe('reducer — RECORD_QUIZ', () => {\n  test('first attempt sets bestScore = score', () => {\n    const next = reducer(INITIAL_STATE, { type: 'RECORD_QUIZ', score: 4, total: 5, now: 'n' });\n    assert.equal(next.quiz.bestScore, 4);\n    assert.equal(next.quiz.attempts, 1);\n  });\n  test('a later lower score does not reduce bestScore', () => {\n    const first = reducer(INITIAL_STATE, { type: 'RECORD_QUIZ', score: 5, total: 5, now: 'n1' });\n    const second = reducer(first, { type: 'RECORD_QUIZ', score: 2, total: 5, now: 'n2' });\n    assert.equal(second.quiz.bestScore, 5);\n    assert.equal(second.quiz.lastScore, 2);\n    assert.equal(second.quiz.attempts, 2);\n  });\n});\n\ndescribe('reducer — SET_WEEKLY_GOAL / RESET_PROGRESS / default', () => {\n  test('goal is clamped to [1,7]', () => {\n    assert.equal(reducer(INITIAL_STATE, { type: 'SET_WEEKLY_GOAL', goal: 50 }).weeklyGoal, 7);\n  });\n  test('non-integer goal keeps the previous value rather than clamping a float', () => {\n    assert.equal(reducer(INITIAL_STATE, { type: 'SET_WEEKLY_GOAL', goal: 3.7 }).weeklyGoal, 3);\n  });\n  test('RESET_PROGRESS clears plan/history/quiz/checklists but preserves proposals', () => {\n    const withProposal = reducer(INITIAL_STATE, { type: 'ADD_PROPOSAL', proposal: { title: 'Idea' }, id: 'id1', now: 'n' });\n    const reset = reducer(withProposal, { type: 'RESET_PROGRESS' });\n    assert.equal(reset.proposals.length, 1);\n    assert.deepEqual(reset.plan, []);\n  });\n  test('unknown action type returns the same state reference', () => {\n    assert.equal(reducer(INITIAL_STATE, { type: 'NOT_REAL' }), INITIAL_STATE);\n  });\n});\n\ndescribe('computeStreak', () => {\n  test('empty history -> {current:0, best:0}', () => {\n    assert.deepEqual(computeStreak([]), { current: 0, best: 0 });\n  });\n  test('duplicate completions on the same day count once toward the streak', () => {\n    const history = [{ completedAt: '2026-10-14T08:00:00' }, { completedAt: '2026-10-14T20:00:00' }];\n    const r = computeStreak(history, new Date(2026, 9, 14));\n    assert.equal(r.current, 1);\n  });\n  test('best streak can be longer than, and separate from, the current streak', () => {\n    const history = [\n      { completedAt: '2026-10-01T08:00:00' }, { completedAt: '2026-10-02T08:00:00' }, { completedAt: '2026-10-03T08:00:00' },\n      { completedAt: '2026-10-10T08:00:00' },\n    ];\n    const r = computeStreak(history, new Date(2026, 9, 10));\n    assert.equal(r.best, 3);\n    assert.equal(r.current, 1);\n  });\n  test('current streak counts yesterday if today has no entry yet', () => {\n    const history = [{ completedAt: '2026-10-13T08:00:00' }];\n    const r = computeStreak(history, new Date(2026, 9, 14));\n    assert.equal(r.current, 1);\n  });\n});\n\ndescribe('weekStart / completionsInWeek', () => {\n  test('weekStart treats Sunday as the end of the week, not the start', () => {\n    const sunday = new Date(2026, 9, 18); // a Sunday\n    assert.equal(weekStart(sunday).getDay(), 1);\n  });\n  test('completionsInWeek is inclusive of week start and exclusive of week end', () => {\n    const start = weekStart(new Date(2026, 9, 14));\n    const end = new Date(start.getTime() + 7 * 86400000);\n    const history = [{ completedAt: start.toISOString() }, { completedAt: end.toISOString() }];\n    assert.equal(completionsInWeek(history, start), 1);\n  });\n});\n\ndescribe('computeBadges', () => {\n  test('air-explorer target defaults to 1 (not 0) when quiz.total is 0/null, so it is not earned for free', () => {\n    const badges = computeBadges(INITIAL_STATE);\n    const b = badges.find((b) => b.id === 'air-explorer');\n    assert.equal(b.target, 1);\n    assert.equal(b.earned, false);\n  });\n});\n\ndescribe('computeMilestones', () => {\n  test('count exactly at a milestone is included in reached, and next is the one after it', () => {\n    const history = Array.from({ length: 5 }, () => ({}));\n    const m = computeMilestones(history);\n    assert.deepEqual(m.reached, [1, 3, 5]);\n    assert.equal(m.next, 10);\n  });\n  test('count beyond the last milestone (20) sets next to null', () => {\n    const history = Array.from({ length: 25 }, () => ({}));\n    assert.equal(computeMilestones(history).next, null);\n  });\n});\n\ndescribe('planStats', () => {\n  test('empty plan has ratio 0, not NaN', () => {\n    assert.deepEqual(planStats([]), { total: 0, done: 0, open: 0, ratio: 0 });\n  });\n});\n```\n\n**Flagged behavioral gap worth confirming with the team, not just testing:** `REMOVE_PLAN_ITEM` and `UPDATE_PLAN_ITEM` always return a new object (via spread/`.filter`/`.map`), even when the target `id` doesn't exist in the plan. `dispatch()` in `store.js` treats `next === state` as \"no-op, don't persist/emit.\" That means removing/updating a non-existent id still triggers a `localStorage` write and a listener re-render. Worth a test asserting the *intended* behavior either way:\n\n```js\ntest('GAP: REMOVE_PLAN_ITEM for a non-existent id still returns a new array reference', () => {\n  const next = reducer(INITIAL_STATE, { type: 'REMOVE_PLAN_ITEM', id: 'does-not-exist' });\n  assert.notEqual(next, INITIAL_STATE); // documents current behavior; flag if unintended\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "5. `features/impact/impact.js` — untested",
        "content": "\n```js\n// tests/features/impact/impact.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { getAlternative, savingPerKm, calculateImpact, roundKg, CALC_LIMITS } from '../../../features/impact/impact.js';\n\ndescribe('getAlternative', () => {\n  test('unknown id falls back to the first alternative (walk)', () => {\n    assert.equal(getAlternative('spaceship').id, 'walk');\n  });\n});\n\ndescribe('savingPerKm', () => {\n  test('walk/bike: full carFactor avoided, both ends of the range equal', () => {\n    assert.deepEqual(savingPerKm('walk', 249), [249, 249]);\n  });\n  test('bus: range from (carFactor - busFactor) to carFactor, clamped at 0', () => {\n    const [low, high] = savingPerKm('bus', 80); // carFactor < bus factor (104)\n    assert.equal(low, 0); // Math.max(0, 80-104)\n    assert.equal(high, 80);\n  });\n  test('carpool: single value at 50% share, not a range', () => {\n    assert.deepEqual(savingPerKm('carpool', 200), [100, 100]);\n  });\n});\n\ndescribe('calculateImpact — clamping', () => {\n  test('out-of-range inputs are clamped to CALC_LIMITS, not silently used as-is', () => {\n    const r = calculateImpact({ tripsPerWeek: 999, km: -5, weeks: 0 });\n    assert.equal(r.inputs.tripsPerWeek, CALC_LIMITS.trips.max);\n    assert.equal(r.inputs.km, CALC_LIMITS.km.min);\n    assert.equal(r.inputs.weeks, CALC_LIMITS.weeks.min);\n  });\n  test('non-finite inputs (NaN/undefined) fall back to the min, not NaN propagation', () => {\n    const r = calculateImpact({ tripsPerWeek: NaN });\n    assert.equal(Number.isFinite(r.inputs.tripsPerWeek), true);\n  });\n});\n\ndescribe('calculateImpact — series + derived fields', () => {\n  test('isRange is false for walk (single-point saving) and true for bus', () => {\n    assert.equal(calculateImpact({ alternative: 'walk' }).isRange, false);\n    assert.equal(calculateImpact({ alternative: 'bus', carFactor: 200 }).isRange, true);\n  });\n  test('activeHours is null for an alternative without speedKmh (carpool)', () => {\n    assert.equal(calculateImpact({ alternative: 'carpool' }).activeHours, null);\n  });\n  test('series has one column per week when weeks <= 12', () => {\n    const r = calculateImpact({ weeks: 6 });\n    assert.equal(r.series.length, 6);\n    assert.equal(r.series.at(-1).week, 6);\n  });\n  test('series collapses to 12 evenly spaced checkpoints when weeks > 12', () => {\n    const r = calculateImpact({ weeks: 52 });\n    assert.equal(r.series.length, 12);\n    assert.equal(r.series.at(-1).week, 52);\n  });\n});\n\ndescribe('roundKg', () => {\n  test('non-finite or non-positive values round to 0', () => {\n    assert.equal(roundKg(NaN), 0);\n    assert.equal(roundKg(-5), 0);\n    assert.equal(roundKg(0), 0);\n  });\n  test('values under 1kg keep one decimal of precision', () => {\n    assert.equal(roundKg(0.37), 0.4);\n  });\n  test('values >= 1kg round to 2 significant figures', () => {\n    assert.equal(roundKg(1234), 1200);\n    assert.equal(roundKg(87), 87);\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "6. `features/actions/finder.js` — untested",
        "content": "\nUse a small fixture action list (dependency-injected via the `actions` param) instead of the full `data/actions.js`, so these tests don't silently break when content changes.\n\n```js\n// tests/features/actions/finder.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { recommendActions, MAX_RESULTS } from '../../../features/actions/finder.js';\n\nconst FIXTURE = [\n  { id: 'a1', timeBucket: 1, cost: 'free', settings: ['home'], activities: ['learning'], mode: 'solo', difficulty: 1 },\n  { id: 'a2', timeBucket: 4, cost: 'flexible', settings: ['school'], activities: ['organizing'], mode: 'group', difficulty: 3 },\n  { id: 'a3', timeBucket: 2, cost: 'low', settings: ['online'], activities: ['creating'], mode: 'both', difficulty: 2 },\n];\n\ndescribe('recommendActions — hard filters', () => {\n  test('excludes actions whose timeBucket exceeds the available time', () => {\n    const r = recommendActions({ time: 1 }, FIXTURE);\n    assert.equal(r.some((x) => x.action.id === 'a2'), false);\n  });\n  test('excludes actions costing more than the stated budget', () => {\n    const r = recommendActions({ time: 4, budget: 'free' }, FIXTURE);\n    assert.equal(r.some((x) => x.action.id === 'a2'), false); // flexible > free\n  });\n  test('excludes actions matching neither setting nor activity', () => {\n    const r = recommendActions({ time: 4, budget: 'flexible', setting: 'neighbourhood', activity: 'participating' }, FIXTURE);\n    assert.equal(r.length, 0);\n  });\n});\n\ndescribe('recommendActions — scoring and ordering', () => {\n  test('matching both setting and activity scores higher than matching one', () => {\n    const r = recommendActions({ time: 4, budget: 'flexible', setting: 'home', activity: 'learning' }, FIXTURE);\n    assert.equal(r[0].action.id, 'a1');\n  });\n  test('ties are broken by ascending difficulty (easier action first)', () => {\n    const tiedFixture = [\n      { ...FIXTURE[0], id: 'easy', difficulty: 1 },\n      { ...FIXTURE[0], id: 'hard', difficulty: 3 },\n    ];\n    const r = recommendActions({ time: 4, budget: 'flexible', setting: 'home', activity: 'learning' }, tiedFixture);\n    assert.equal(r[0].action.id, 'easy');\n  });\n  test('results are capped at MAX_RESULTS', () => {\n    const many = Array.from({ length: 10 }, (_, i) => ({ ...FIXTURE[0], id: `a${i}` }));\n    const r = recommendActions({ time: 4, budget: 'flexible', setting: 'home', activity: 'learning' }, many);\n    assert.equal(r.length, MAX_RESULTS);\n  });\n  test('a group-only action matched for a solo visitor gets a caution, not an exclusion', () => {\n    const r = recommendActions({ time: 4, budget: 'flexible', setting: 'school', activity: 'organizing', mode: 'solo' }, FIXTURE);\n    const a2 = r.find((x) => x.action.id === 'a2');\n    assert.ok(a2);\n    assert.ok(a2.cautions.some((c) => c.includes('команда')));\n  });\n});\n\ndescribe('recommendActions — defaults', () => {\n  test('missing answer fields fall back to DEFAULT_FINDER_ANSWERS', () => {\n    const withDefaults = recommendActions({}, FIXTURE);\n    const explicit = recommendActions(\n      { time: 2, budget: 'free', setting: 'school', activity: 'participating', mode: 'solo' }, FIXTURE,\n    );\n    assert.deepEqual(withDefaults.map((r) => r.action.id), explicit.map((r) => r.action.id));\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "7. `app/api/air-quality/route.js` — integration gap, zero coverage",
        "content": "\nNode's built-in `fetch`/`Request`/`Response` globals make this testable without any Next.js test harness — just call `GET()` directly and stub `globalThis.fetch`.\n\n```js\n// tests/app/api/air-quality.test.js\nimport { test, describe, beforeEach, afterEach, mock } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { GET } from '../../../app/api/air-quality/route.js';\n\nconst ORIGINAL_FETCH = globalThis.fetch;\nconst ORIGINAL_ENV = process.env.WAQI_API_TOKEN;\n\nafterEach(() => {\n  globalThis.fetch = ORIGINAL_FETCH;\n  process.env.WAQI_API_TOKEN = ORIGINAL_ENV;\n  mock.reset();\n});\n\ndescribe('GET /api/air-quality', () => {\n  test('unknown city id -> 400 unknown-city', async () => {\n    const res = await GET(new Request('http://x/api/air-quality?city=atlantis'));\n    assert.equal(res.status, 400);\n    assert.equal((await res.json()).reason, 'unknown-city');\n  });\n\n  test('no token configured -> 200 unconfigured, no network call made', async () => {\n    delete process.env.WAQI_API_TOKEN;\n    globalThis.fetch = mock.fn(() => { throw new Error('should not be called'); });\n    const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.equal(res.status, 200);\n    assert.equal((await res.json()).status, 'unconfigured');\n  });\n\n  test('upstream non-OK HTTP status -> 502 with status code in reason', async () => {\n    process.env.WAQI_API_TOKEN = 'test-token';\n    globalThis.fetch = mock.fn(async () => new Response(null, { status: 503 }));\n    const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.equal(res.status, 502);\n    assert.equal((await res.json()).reason, 'upstream-503');\n  });\n\n  test('fetch throws TimeoutError -> 502 reason \"timeout\"', async () => {\n    process.env.WAQI_API_TOKEN = 'test-token';\n    globalThis.fetch = mock.fn(async () => { const e = new Error('t'); e.name = 'TimeoutError'; throw e; });\n    const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.equal((await res.json()).reason, 'timeout');\n  });\n\n  test('fetch throws a generic error -> 502 reason \"network\"', async () => {\n    process.env.WAQI_API_TOKEN = 'test-token';\n    globalThis.fetch = mock.fn(async () => { throw new Error('ECONNRESET'); });\n    const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.equal((await res.json()).reason, 'network');\n  });\n\n  test('successful upstream response is normalized and gets Cache-Control: no-store', async () => {\n    process.env.WAQI_API_TOKEN = 'test-token';\n    globalThis.fetch = mock.fn(async () => Response.json({\n      status: 'ok',\n      data: { city: { geo: [41.3, 69.24] }, time: { iso: new Date().toISOString() }, aqi: 60 },\n    }));\n    const res = await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.equal(res.headers.get('cache-control'), 'no-store');\n    assert.equal((await res.json()).status, 'ok');\n  });\n\n  test('token is URL-encoded into the upstream request', async () => {\n    process.env.WAQI_API_TOKEN = 'a token/with+chars';\n    const calls = [];\n    globalThis.fetch = mock.fn(async (url) => { calls.push(url); return Response.json({ status: 'error', data: 'x' }); });\n    await GET(new Request('http://x/api/air-quality?city=tashkent'));\n    assert.ok(calls[0].includes(encodeURIComponent('a token/with+chars')));\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "8. Data \"contract\" tests — untested, cheap, high regression value",
        "content": "\nStatic content files (`data/actions.js`, `data/quiz.js`, `data/cities.js`) have no validation that they stay internally consistent as they grow. These catch content-authoring mistakes (e.g., a new action referencing a `setting` value nobody defined a label for).\n\n```js\n// tests/data/contracts.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { ACTIONS, SETTING_LABELS, ACTIVITY_LABELS, COST_LABELS, EFFECTS } from '../../data/actions.js';\nimport { QUIZ } from '../../data/quiz.js';\nimport { CITIES, getCityById } from '../../data/cities.js';\n\ndescribe('ACTIONS content contract', () => {\n  test('every action references known setting/activity/cost/effect keys', () => {\n    for (const a of ACTIONS) {\n      for (const s of a.settings) assert.ok(s in SETTING_LABELS, `${a.id}: unknown setting \"${s}\"`);\n      for (const act of a.activities) assert.ok(act in ACTIVITY_LABELS, `${a.id}: unknown activity \"${act}\"`);\n      assert.ok(a.cost in COST_LABELS, `${a.id}: unknown cost \"${a.cost}\"`);\n      assert.ok(a.effect in EFFECTS, `${a.id}: unknown effect \"${a.effect}\"`);\n      assert.ok([1, 2, 3, 4].includes(a.timeBucket), `${a.id}: invalid timeBucket`);\n      assert.ok([1, 2, 3].includes(a.difficulty), `${a.id}: invalid difficulty`);\n      assert.ok(['solo', 'group', 'both'].includes(a.mode), `${a.id}: invalid mode`);\n    }\n  });\n  test('action ids are unique', () => {\n    const ids = ACTIONS.map((a) => a.id);\n    assert.equal(new Set(ids).size, ids.length);\n  });\n});\n\ndescribe('QUIZ content contract', () => {\n  test('every \"correct\" index is within the options array bounds', () => {\n    for (const q of QUIZ) {\n      assert.ok(q.correct >= 0 && q.correct < q.options.length, `${q.id}: correct index out of range`);\n    }\n  });\n  test('quiz ids are unique', () => {\n    const ids = QUIZ.map((q) => q.id);\n    assert.equal(new Set(ids).size, ids.length);\n  });\n});\n\ndescribe('getCityById', () => {\n  test('unknown id returns null, not undefined', () => {\n    assert.equal(getCityById('nowhere'), null);\n  });\n  test('city ids are unique', () => {\n    const ids = CITIES.map((c) => c.id);\n    assert.equal(new Set(ids).size, ids.length);\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "9. Integration gaps that need new test infrastructure first",
        "content": "\nThese can't be meaningfully unit-tested with the current setup — flagging them rather than writing skeletons that would just fail on missing deps:\n\n| File | Why it's blocked | What's needed |\n|---|---|---|\n| `features/progress/store.js` | `useHavoState`/`isPersistenceAvailable` wrap `useSyncExternalStore`; module holds singleton `state`, so tests leak into each other across the same process | A DOM env (jsdom) + a way to reset the module's singleton between tests (currently no `resetState()` export) — worth adding one *for testability* |\n| `features/feedback/toast.js` | Same `useSyncExternalStore` + singleton `current`/`timer` pattern; relies on real timers | jsdom, `node:test`'s fake timers, or extracting `showToast`/`dismissToast` from the hook so logic is callable headlessly |\n| `hooks/useDialogBehavior.js` | Focus trap, Escape handling, scroll lock — all DOM-dependent | jsdom + `@testing-library/react` (`renderHook`) to drive real `keydown` events and assert `document.activeElement` |\n| `hooks/useActiveSection.js` | Depends on `IntersectionObserver`, not available in Node | jsdom + an `IntersectionObserver` polyfill/mock |\n| `hooks/useMediaQuery.js`, `useInViewport.js`, `useIsClient.js` | Same — `matchMedia`/`IntersectionObserver`/hydration timing | jsdom |\n| All `components/*` | No component tests exist at all (Hero, Header, forms, dialogs) | `@testing-library/react` + jsdom; none of these are currently `devDependencies` |\n\n**Concrete next step if you want this closed out:** add `jsdom` and `@testing-library/react` as `devDependencies`, and either run `node --test` with `--experimental-test-coverage` plus a jsdom bootstrap, or switch the test runner to Vitest (which has first-class jsdom + React support and would subsume the `node:test` files above with minimal changes, since the assertions are plain `assert`-style).\n\n---\n\n",
        "level": 2
      },
      {
        "title": "Summary",
        "content": "- **0% coverage today**, no `tests/` directory despite the npm script expecting one.\n- ~35 pure functions across 6 files are fully testable right now with zero new dependencies — that's the bulk of the business logic (points, streaks, badges, CO₂ impact, action matching, WAQI parsing).\n- One security-relevant branch (`safeUrl`'s protocol allowlist in `waqi.js`) has no test proving it actually blocks `javascript:` URLs.\n- One likely-unintended behavior found: `REMOVE_PLAN_ITEM`/`UPDATE_PLAN_ITEM` return a new object even for a non-matching id, which `store.js`'s `dispatch()` reads as \"state changed\" — causes an unnecessary `localStorage` write/re-render. Worth a decision + a test either way.\n- React hooks, the external stores, and all components have no test infra at all — that's a separate investment (jsdom + Testing Library) from the pure-logic gap closed above.",
        "level": 3
      }
    ],
    "codeBlocks": [
      {
        "language": "js",
        "code": "// tests/lib/format.test.js\nimport { test, describe } from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  plural, pluralize, formatNumber, formatDate, formatDateTime,\n  dayKey, timeAgo, daysUntil, deadlineLabel,\n} from '../../lib/format.js';\n\ndescribe('plural', () => {\n  const forms = ['день', 'дня', 'дней'];\n  test('1 -> singular, 21 -> singular (not just n%10)', () => {\n    assert.equal(plural(1, forms), 'день');\n    assert.equal(plural(21, forms), 'день');\n  });\n  test('teens 11-19 are always the plural-of-many form', () => {\n    assert.equal(plural(11, forms), 'дней');\n    assert.equal(plural(14, forms), 'дней');\n    assert.equal(plural(19, forms), 'дней');\n  });\n  test('2-4 and 22-24 use the \"few\" form', () => {\n    assert.equal(plural(2, forms), 'дня');\n    assert.equal(plural(22, forms), 'дня');\n  });\n  test('0, 5-20, 25+ use the \"many\" form', () => {\n    assert.equal(plural(0, forms), 'дней');\n    assert.equal(plural(5, forms), 'дней');\n  });\n  test('negative numbers use abs value', () => {\n    assert.equal(plural(-1, forms), 'день');\n  });\n});\n\ndescribe('formatNumber', () => {\n  test('non-finite values render as em dash', () => {\n    assert.equal(formatNumber(NaN), '—');\n    assert.equal(formatNumber(Infinity), '—');\n  });\n  test('respects maximumFractionDigits and caches formatter per precision', () => {\n    assert.equal(formatNumber(3.14159, 2), '3,14');\n  });\n});\n\ndescribe('formatDate / formatDateTime', () => {\n  test('invalid date input renders as em dash', () => {\n    assert.equal(formatDate('not-a-date'), '—');\n    assert.equal(formatDateTime(NaN), '—');\n  });\n  test('accepts Date, ISO string and timestamp number equivalently', () => {\n    const d = new Date(2026, 0, 15);\n    assert.equal(formatDate(d), formatDate(d.toISOString()));\n  });\n});\n\ndescribe('dayKey', () => {\n  test('pads single-digit month/day', () => {\n    assert.equal(dayKey(new Date(2026, 0, 5)), '2026-01-05');\n  });\n  test('uses local time, not UTC', () => {\n    // Regression target: a Date just after local midnight must not roll back a day under UTC conversion.\n  });\n});\n\ndescribe('timeAgo', () => {\n  const now = new Date(2026, 9, 14, 12, 0, 0).getTime();\n  test('< 1 minute -> \"только что\"', () => {\n    assert.equal(timeAgo(now - 30_000, now), 'только что');\n  });\n  test('boundary at 60 minutes switches to hours', () => {\n    assert.equal(timeAgo(now - 59 * 60_000, now).includes('минут'), true);\n    assert.equal(timeAgo(now - 60 * 60_000, now).includes('час'), true);\n  });\n  test('boundary at 24 hours switches to days', () => {\n    assert.equal(timeAgo(now - 23 * 3600_000, now).includes('час'), true);\n    assert.equal(timeAgo(now - 24 * 3600_000, now).includes('день') || timeAgo(now - 24 * 3600_000, now).includes('дня'), true);\n  });\n  test('invalid timestamp renders em dash', () => {\n    assert.equal(timeAgo('garbage', now), '—');\n  });\n  test('GAP: future timestamps (clock skew) collapse to \"только что\" instead of signalling the future', () => {\n    // diffMin is negative -> `< 1` is true. Decide if this is desired; write the assertion either way.\n    assert.equal(timeAgo(now + 5 * 60_000, now), 'только что');\n  });\n});\n\ndescribe('daysUntil / deadlineLabel', () => {\n  const now = new Date(2026, 9, 14);\n  test('null/empty deadline -> null', () => {\n    assert.equal(daysUntil(null, now), null);\n    assert.equal(daysUntil('', now), null);\n  });\n  test('malformed deadline string -> null, not NaN', () => {\n    assert.equal(daysUntil('2026-13', now), null);\n  });\n  test('today -> 0, tomorrow -> 1, yesterday -> -1', () => {\n    assert.equal(daysUntil('2026-10-14', now), 0);\n    assert.equal(daysUntil('2026-10-15', now), 1);\n    assert.equal(daysUntil('2026-10-13', now), -1);\n  });\n  test('deadlineLabel tones: danger/warn/warn/neutral', () => {\n    assert.equal(deadlineLabel('2026-10-13', now).tone, 'danger');\n    assert.equal(deadlineLabel('2026-10-14', now).tone, 'warn');\n    assert.equal(deadlineLabel('2026-10-15', now).tone, 'warn');\n    assert.equal(deadlineLabel('2026-10-20', now).tone, 'neutral');\n  });\n});"
      },
