const SUN_DIR = new Vector3(-0.85, 0.45, 0.65).normalize();
const ATMOSPHERE_SCALE = 1.14;
// How far (radians) Uzbekistan sits left of the visible centre of the disc,
// i.e. towards the headline.
const MARKER_OFFSET = 0.28;
